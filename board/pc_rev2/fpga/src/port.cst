// gpio は Tang Nano 9K の場合に HDMI 端子と兼ねていて反応が遅い。
// fastio はそのような遅延がないことが保証されている IO。
// ちなみに Tang Nano 9K の gpio は fastio より2.3us 程度反応が遅れる。
IO_LOC  "fastio[0]" 77;
IO_LOC  "fastio[1]" 76;
IO_LOC  "fastio[2]" 31;
IO_PORT "fastio[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24;
IO_PORT "fastio[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24;
IO_PORT "fastio[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24;

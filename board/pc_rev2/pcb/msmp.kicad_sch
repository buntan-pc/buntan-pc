	(text_box "VDD		5V				3.3V\nR33		390Ω/0.25W	390Ω/0.25W\nR34		220Ω/0.25W	33Ω/0.5W\nR35		220Ω/0.25W	10Ω/0.25W"
		(exclude_from_sim no)

 */

module top (
  sys_clk: input clock,
  rst_n_raw: input 'noclk reset_async_low,
  sw_n_raw: input 'noclk logic,
  onboard_led: output logic<6>,
  clk_p: output 'dvi clock,
  clk_n: output 'dvi clock,
  data_p: output 'dvi logic[3],
  data_n: output 'dvi logic[3],
  uart3_rx:  input  bit,
  uart3_tx:  output bit,
  uart3b_rx: input  bit,
  uart3b_tx: output bit,
  usb_dp_raw: inout 'usb_raw tri logic,
  usb_dm_raw: inout 'usb_raw tri logic,
  usb_vbus_ctrl: output logic,
  dbg: output bit<16>,
) {
  const FONT_W: u8 = 8;
  const FONT_H: u8 = 16;
  const SCRN_W_PIX: u16 = 1024;
  const SCRN_H_PIX: u16 = 600;
  const STATUSLINE_H_PIX: u16 = 4;
  const SCRN_W_CHAR: u16 = SCRN_W_PIX / FONT_W;
  const SCRN_H_CHAR: u16 = (SCRN_H_PIX - STATUSLINE_H_PIX) / FONT_H;
  const SCRN_LINE_WIDTH: u8 = $clog2(SCRN_H_CHAR);
  const SCRN_OFFSET_WIDTH: u8 = $clog2(SCRN_W_CHAR);

  struct DVIParamsSingle {
    bp : u16, // back porch
    act: u16, // active
    fp : u16, // front porch
    syn: u16, // sync
  }
  struct DVIParams {
    h : DVIParamsSingle,
    v : DVIParamsSingle,
  }
  const CVT_RBv2 : DVIParams = DVIParams'{
    h : DVIParamsSingle'{
      bp : 40,
      act: SCRN_W_PIX,
      fp : 8,
      syn: 32,
    },
    v : DVIParamsSingle'{
      bp : 6,
      act: SCRN_H_PIX,
      fp : 4,
      syn: 8,
    },
  };
  const CVT : DVIParams = DVIParams'{
    h : DVIParamsSingle'{
      bp : 128,
      act: SCRN_W_PIX,
      fp : 32,
      syn: 96,
    },
    v : DVIParamsSingle'{
      bp : 8,
      act: SCRN_H_PIX,
      fp : 3,
      syn: 10,
    },
  };

  const DP : DVIParams = CVT_RBv2;

  var rst_n : reset_async_low;
  unsafe (cdc) {
    inst rst_synchronizer: $std::synchronizer_basic #(
      WIDTH: 1,
      STAGES: 2,
    ) (
      i_clk: sys_clk,
      i_rst: rst_n_raw,
      i_d: 1,
      o_d: rst_n,
    );
  }


  // ディスプレイ用クロック生成
  var dvi_rst_n : 'dvi reset_async_low;
  var fclk : 'dvif clock;
  var pclk : 'dvi clock;
  var fclk_pll_lock : 'dvi logic;

  unsafe (cdc) {
    inst fclk_pll: $sv::gowin_rpll_fclk(
      clkin: sys_clk,
      clkout: fclk,
      lock: fclk_pll_lock
    );

    assign dvi_rst_n = rst_n & fclk_pll_lock;

    inst clkdiv: $sv::CLKDIV #(
      DIV_MODE: "5",
      GSREN: "false",
    ) (
      CLKOUT: pclk,
      HCLKIN: fclk,
      RESETN: dvi_rst_n,
      CALIB: 0,
    );

    var data_ser : 'dvi logic[3];
    for i in 0..3 :gen_oser {
      inst data_oser : $sv::OSER10 #(
        GSREN: "false",
        LSREN: "true"
      ) (
        Q: data_ser[i],
        D0: dvi_out_data[i][0],
        D1: dvi_out_data[i][1],
        D2: dvi_out_data[i][2],
        D3: dvi_out_data[i][3],
        D4: dvi_out_data[i][4],
        D5: dvi_out_data[i][5],
        D6: dvi_out_data[i][6],
        D7: dvi_out_data[i][7],
        D8: dvi_out_data[i][8],
        D9: dvi_out_data[i][9],
        FCLK: fclk,
        PCLK: pclk,
        RESET: ~dvi_rst_n,
      );
    }

    var clk_ser : 'dvi logic;
    inst clk_oser : $sv::OSER10 #(
      GSREN: "false",
      LSREN: "true"
    ) (
      Q: clk_ser,
      D0: 1'b1,
      D1: 1'b1,
      D2: 1'b1,
      D3: 1'b1,
      D4: 1'b1,
      D5: 1'b0,
      D6: 1'b0,
      D7: 1'b0,
      D8: 1'b0,
      D9: 1'b0,
      FCLK: fclk,
      PCLK: pclk,
      RESET: ~dvi_rst_n,
    );
  } // unsafe cdc

  for i in 0..3 :gen_lvds {
    inst lvds_data : $sv::ELVDS_OBUF (
      I: data_ser[i],
      O: data_p[i],
      OB: data_n[i],
    );
  }
  inst lvds_clk : $sv::ELVDS_OBUF (
    I: clk_ser,
    O: clk_p,
    OB: clk_n,
  );

  // USB キーボード認証
  var usb_challenge_char : 'usb bit<8>;
  var usb_challenge_req : 'usb bit;
  var usb_challenge_char_sync : bit<8>;
  var usb_challenge_char_valid : bit;
  inst usb_challenge_sync : flip_sync::<u8> (
    i_clk: sys_clk,
    i_rst: rst_n,
    i_data: usb_challenge_char,
    i_req:  usb_challenge_req,
    o_data: usb_challenge_char_sync,
    o_valid: usb_challenge_char_valid,
  );

  var usb_key_auth_state : 'usb usb::KeyAuthState;
  var usb_key_auth_state_sync_bit : bit<2>;
  inst usb_auth_state_sync : $std::synchronizer_basic #(
    WIDTH: 2,
    STAGES: 2,
  ) (
    i_clk: sys_clk,
    i_rst: rst_n,
    i_d: usb_key_auth_state,
    o_d: usb_key_auth_state_sync_bit,
  );

  const KEY_AUTH_SCRN_LINE: u16 = SCRN_H_CHAR - 1;
  const KEY_AUTH_SCRN_OFFSET: u16 = SCRN_W_CHAR - 1;

  let usb_key_auth_state_sync : usb::KeyAuthState = usb_key_auth_state_sync_bit as usb::KeyAuthState;

  /*
  var usb_key_auth_state_prev : usb::KeyAuthState;
  var usb_key_auth_state_changed : bit;
  always_ff (sys_clk, rst_n) {
    if_reset {
      usb_key_auth_state_changed = 0;
      usb_key_auth_state_prev = usb::KeyAuthState::BadDevice;
      // 最初に changed が真になるように、初期値を BadDevice にしておく
    } else {
      usb_key_auth_state_changed = usb_key_auth_state_prev != usb_key_auth_state_sync;
      usb_key_auth_state_prev = usb_key_auth_state_sync;
    }
  }
  */

  var usb_key_auth_state_sync_dvi_bit : 'dvi bit<2>;
  inst usb_key_auth_state_dvi_synchronizer: $std::synchronizer_basic #(
    WIDTH: 2,
    STAGES: 2,
  ) (
    i_clk: pclk,
    i_rst: dvi_rst_n,
    i_d: usb_key_auth_state_sync,
    o_d: usb_key_auth_state_sync_dvi_bit,
  );
  let usb_key_auth_state_sync_dvi : 'dvi usb::KeyAuthState = usb_key_auth_state_sync_dvi_bit as usb::KeyAuthState;

  var usb_challenge_char_buf : u8;
  always_ff (sys_clk, rst_n) {
    if_reset {
      usb_challenge_char_buf = 0;
    } else if usb_challenge_char_valid {
      usb_challenge_char_buf = usb_challenge_char_sync;
    }
  }

  var usb_challenge_char_buf_dvi : 'dvi u8;
  inst usb_challenge_char_buf_dvi_synchronizer: $std::synchronizer_basic #(
    WIDTH: 8,
    STAGES: 2,
  ) (
    i_clk: pclk,
    i_rst: dvi_rst_n,
    i_d: usb_challenge_char_buf,
    o_d: usb_challenge_char_buf_dvi,
  );

  // ディスプレイ制御
  enum DVIState: bit<2> {
    sync,
    back_porch,
    active,
    front_porch,
  }

  var pixel_h : 'dvi bit<11>; // 0～2047
  var next_pixel_h : 'dvi bit<11>;
  var state_h : 'dvi DVIState;

  var pixel_v : 'dvi bit<10>; // 0～1023
  var state_v : 'dvi DVIState;

  const pixels_per_line : u16 = DP.h.bp + DP.h.act + DP.h.fp + DP.h.syn;
  assign next_pixel_h = if pixel_h <: pixels_per_line - 1 ? pixel_h + 1 : 0;
  assign state_h = switch {
    pixel_h <: DP.h.syn                      : DVIState::sync,
    pixel_h <: DP.h.syn + DP.h.bp            : DVIState::back_porch,
    pixel_h <: DP.h.syn + DP.h.bp + DP.h.act : DVIState::active,
    default                                  : DVIState::front_porch,
  };
  assign state_v = switch {
    pixel_v <: DP.v.syn                      : DVIState::sync,
    pixel_v <: DP.v.syn + DP.v.bp            : DVIState::back_porch,
    pixel_v <: DP.v.syn + DP.v.bp + DP.v.act : DVIState::active,
    default                                  : DVIState::front_porch,
  };

  always_ff (pclk, dvi_rst_n) {
    if_reset {
      pixel_h = 0;
    } else {
      pixel_h = next_pixel_h;
    }
  }
  always_ff (pclk, dvi_rst_n) {
    if_reset {
      pixel_v = 0;
    } else if next_pixel_h == 0 {
      if pixel_v <: DP.v.bp + DP.v.act + DP.v.fp + DP.v.syn - 1 {
        pixel_v += 1;
      } else {
        pixel_v = 0;
      }
    }
  }

  var data_enable : 'dvi bit;
  assign data_enable = state_h == DVIState::active && state_v == DVIState::active;

  const PIXEL_WIDTH: u8 = 10;
  var act_pixel_h : 'dvi bit<PIXEL_WIDTH>;
  var act_pixel_v : 'dvi bit<PIXEL_WIDTH>;
  assign act_pixel_h = pixel_h - DP.h.syn - DP.h.bp;
  assign act_pixel_v = pixel_v - DP.v.syn - DP.v.bp;

  var statusline_is_active: bit; // 1 = ステータスラインを使う
  var statusline_is_active_dvi: 'dvi bit;

  let pixel_v_shift: 'dvi bit<PIXEL_WIDTH> = case statusline_is_active_dvi {
    0:       STATUSLINE_H_PIX,
    default: if act_pixel_v <: FONT_H ? 0 : STATUSLINE_H_PIX,
  };
  let act_pixel_v_shifted: 'dvi bit<PIXEL_WIDTH> = act_pixel_v - pixel_v_shift;

  #[allow(initial_assign)]
  var font_mem: 'dvi bit<FONT_W>[128 * FONT_H];
  var font_buf: 'dvi bit<FONT_W>;

  /* 信号タイミング (WaveDrom)

  {signal: [
    {name: 'pclk',          wave: 'p.......'},
    {name: 'pixel_v',       wave: '=.......', data: ['{m, n}']},
    {name: 'pixel_h[2:0]',  wave: '========', data: [3, 4, 5, 6, 7, 0, 1, 2]},
    {name: '(pixel_h+3)>>3',wave: '=.=.....', data: ['k', 'k+1']},
    {name: 'scrn_line',     wave: '=.......', data: ['m']},
    {name: 'scrn_offset',   wave: '=.=.....', data: ['k', 'k+1']},
    {name: 'scrn_data',     wave: '=..=....', data: ["'A'", "'B'"]},
    {name: 'ld_scrn_buf',   wave: '0..10...'},
    {name: 'scrn_buf',      wave: '=...=...', data: ["'A'", "'B'"]},
    {name: 'font_addr',     wave: '=...=...', data: ["('A'<<4)+n", "('B'<<4)+n"]},
    {name: 'font_buf',      wave: '=....=..', data: ['Aの行n', 'Bの行n']},
  ]}

   */

  var font_xpos: 'dvi bit<$clog2(FONT_W)>;
  var font_ypos: 'dvi bit<$clog2(FONT_H)>;
  assign font_xpos = act_pixel_h[$clog2(FONT_W)-1:0];
  assign font_ypos = act_pixel_v_shifted[$clog2(FONT_H)-1:0];

  /*
   * scrn_line = 0            : 画面の最上段 = 最も古い履歴 OR ステータスバー
   * scrn_line = SCRN_H_CHAR-2: 画面の下から2行目 = 最も新しい履歴
   * scrn_line = SCRN_H_CHAR-1: 画面の最下段 = 入力中の行
   */
  let scrn_line: 'dvi bit<SCRN_LINE_WIDTH> = act_pixel_v_shifted >> $clog2(FONT_H);

  // 行内での横方向のオフセット
  let scrn_offset: 'dvi bit<SCRN_OFFSET_WIDTH> =
    if state_h == DVIState::back_porch ? 0 : (act_pixel_h + 3) >> $clog2(FONT_W);

  var scrn_data: 'dvi bit<9>; // メモリからの読み出しデータ信号
  var ld_scrn_buf: 'dvi logic;
  assign ld_scrn_buf = font_xpos == FONT_W - 2;

  // 次のロード信号で表示する文字
  let next_char: 'dvi u8 = switch {
    // 画面右下に USB 認証用文字をオーバーレイ表示
    scrn_line == SCRN_H_CHAR - 1 && scrn_offset == SCRN_W_CHAR - 2:
      case usb_key_auth_state_sync_dvi {
        usb::KeyAuthState::Authorized:
          "*",
        usb::KeyAuthState::BadDevice:
          "!",
        default: // Challenging
          if usb_challenge_char_buf_dvi == '0 ? "?" : usb_challenge_char_buf_dvi,
      },
    // 通常時の表示文字
    default: scrn_data,
  };

  // スクリーンメモリ
  var scrn_wen: bit;
  var scrn_wr_pos_line: bit<SCRN_LINE_WIDTH>[2];
  var scrn_wr_pos_offset: bit<SCRN_OFFSET_WIDTH>[2];
  var scrn_wr_pos_line_save: bit<SCRN_LINE_WIDTH>;
  var scrn_wr_pos_offset_save: bit<SCRN_OFFSET_WIDTH>;
  var scrn_wr_data: bit<8>;
  var scrn_clear_cnt: u8;

  var use_extscrn: bit; // 1 = 代替バッファ
  var use_extscrn_dvi: 'dvi bit;

  var scrn_data_main: 'dvi bit<9>;
  var scrn_data_status: 'dvi bit<9>;
  var scrn_data_ext: 'dvi bit<9>;

  assign scrn_data = switch {
    use_extscrn_dvi: scrn_data_ext,
    statusline_is_active_dvi & scrn_line == 0: scrn_data_status,
    default: scrn_data_main,
  };

  let scrn_wr_line_main = scrn_wr_pos_line[0];
  let scrn_wr_offset_main = scrn_wr_pos_offset[0];
  let scrn_wr_line_ext = scrn_wr_pos_line[1];
  let scrn_wr_offset_ext = scrn_wr_pos_offset[1];

  let scrn_wr_target_status: bit = scrn_wr_pos_line[0] == 0;
  var scrn_scroll: bit[2];

  inst scrn_main: ScreenMemory#(
    NUM_LINES: SCRN_H_CHAR,
    LINE_CAPACITY: SCRN_W_CHAR,
  ) (
    clk:    sys_clk,
    rst:    rst_n,
    wen:    ~use_extscrn & scrn_wen & ~scrn_wr_target_status,
    line:   scrn_wr_line_main,
    offset: scrn_wr_offset_main,
    din:    {1'b0, scrn_wr_data},
    scroll: scrn_scroll[0],

    clk_dvi:    pclk,
    rst_dvi:    dvi_rst_n,
    line_dvi:   scrn_line,
    offset_dvi: scrn_offset,
    dout_dvi:   scrn_data_main,
  );
  inst scrn_ext: ScreenMemory#(
    NUM_LINES: SCRN_H_CHAR,
    LINE_CAPACITY: SCRN_W_CHAR,
  ) (
    clk:    sys_clk,
    rst:    rst_n,
    wen:    use_extscrn & scrn_wen,
    line:   scrn_wr_line_ext,
    offset: scrn_wr_offset_ext,
    din:    {1'b0, scrn_wr_data},
    scroll: scrn_scroll[1],

    clk_dvi:    pclk,
    rst_dvi:    dvi_rst_n,
    line_dvi:   scrn_line,
    offset_dvi: scrn_offset,
    dout_dvi:   scrn_data_ext,
  );

  // ステータスライン用メモリ
  // scrn_wr_line_main == 0 への書き込みをステータスラインへの書き込みとする
  inst scrn_status: ScreenMemory#(
    NUM_LINES: 1,
    LINE_CAPACITY: SCRN_W_CHAR,
  ) (
    clk:    sys_clk,
    rst:    rst_n,
    wen:    ~use_extscrn & scrn_wen & scrn_wr_target_status,
    line:   scrn_wr_line_main,
    offset: scrn_wr_offset_main,
    din:    {1'b0, scrn_wr_data},
    scroll: '0,

    clk_dvi:    pclk,
    rst_dvi:    dvi_rst_n,
    line_dvi:   scrn_line,
    offset_dvi: scrn_offset,
    dout_dvi:   scrn_data_status,
  );

  var scrn_buf: 'dvi bit<9>;  // 現在表示中の文字
  always_ff (pclk, dvi_rst_n) {
    if_reset {
      scrn_buf = 0;
    } else if ld_scrn_buf {
      scrn_buf = next_char;
    }
  }

  let font_addr: 'dvi bit<$clog2(128 * FONT_H)> =
    scrn_buf << $clog2(FONT_H) | font_ypos;

  always_ff (pclk) {
    font_buf = font_mem[font_addr];
  }

  unsafe (cdc) {
    always_ff (pclk, dvi_rst_n) {
      if_reset {
        use_extscrn_dvi = 0;
        statusline_is_active_dvi = 0;
      } else if state_v == DVIState::sync {
        use_extscrn_dvi = use_extscrn;
        statusline_is_active_dvi = statusline_is_active & !use_extscrn;
      }
    }
  }

  var scrn_wr_valid: 'dvi bit;
  var scrn_wr_ready: 'dvi bit;
  var scrn_wr_buf: 'dvi bit<8>;

  var uart_rx_data:  bit<8>;
  var uart_tx_data:  bit<8>;
  var uart_rx_full:  bit;
  var uart_wr:       bit;
  var uart_tx_ready: bit;

  // USB キーボードの入力を UART へ送る
  var usb_key_ascii : 'usb bit<8>;
  var usb_key_req : 'usb bit;
  inst usb_ascii_sync : flip_sync::<u8> (
    i_clk: sys_clk,
    i_rst: rst_n,
    i_data: usb_key_ascii,
    i_req:  usb_key_req,
    o_data: uart_tx_data,
    o_valid: uart_wr,
  );

  var uart_rx: bit;
  var uart_tx: bit;
  assign uart_rx = uart3_rx & uart3b_rx;
  assign uart3_tx = uart_tx;
  assign uart3b_tx = uart_tx;

  inst uart3b: Uart (
    clk:      sys_clk,
    rst_n:    rst_n,
    rx:       uart_rx,
    tx:       uart_tx,
    rx_data:  uart_rx_data,
    tx_data:  uart_tx_data,
    rd:       uart_rx_full,
    rx_full:  uart_rx_full,
    wr:       uart_wr,
    tx_ready: uart_tx_ready,
  );

  enum ScrnRecvState: bit<2> {
    idle,
    inc,
    clear,
  }
  var scrn_recv_state: ScrnRecvState;

  var es_recog: bit;
  var es_kind:  escseq::Kind;
  var es_numbuf: u16[4];
  var es_numbuf_len: u8;
  inst es_recognizer: ESRecognizer(
    i_clk:    sys_clk,
    i_rst_n:  rst_n,
    i_char:   uart_rx_data,
    i_char_v: uart_rx_full,
    o_recog:  es_recog,
    o_kind:   es_kind,
    o_numbuf: es_numbuf,
    o_numbuf_len: es_numbuf_len,
  );

  always_ff (sys_clk, rst_n) {
    if_reset {
      scrn_wen = 0;
      scrn_wr_data = 0;
      scrn_recv_state = ScrnRecvState::idle;
      scrn_wr_pos_line[0] = 0;
      scrn_wr_pos_line[1] = 0;
      scrn_wr_pos_offset[0] = 0;
      scrn_wr_pos_offset[1] = 0;
      scrn_clear_cnt = 0;
      use_extscrn = 0;
      statusline_is_active = 0;
      scrn_scroll[0] = 0;
      scrn_scroll[1] = 0;
    } else if es_recog {
      case es_kind {
        escseq::Kind::NONE: case uart_rx_data {
          8'h08: { // BS
            scrn_wen = 0;
            if scrn_wr_pos_offset[use_extscrn] >: 0 {
              // 行またぎの削除は今のところ非対応
              scrn_wr_pos_offset[use_extscrn] -= 1;
            }
            scrn_recv_state = ScrnRecvState::idle;
          }
          8'h0A: { // LF
            case use_extscrn {
              0: {
                scrn_scroll[0] = 1;
                scrn_wr_pos_offset[0] = SCRN_W_CHAR - 1;
                scrn_wr_data = 0;
                scrn_wen = 1;
                scrn_clear_cnt = SCRN_W_CHAR - 1;
                scrn_recv_state = ScrnRecvState::clear;
              }
              1: {
                // 代替バッファでは、改行は次の行の左端にカーソルを移動させるだけ
                scrn_wr_pos_line[1] += 1;
                scrn_wr_pos_offset[1] = 0;
                scrn_wen = 0;
                scrn_recv_state = ScrnRecvState::idle;
              }
            }
          }
          8'h0D: { // CR
            scrn_wen = 0;
            scrn_recv_state = ScrnRecvState::idle;
          }
          default: {
            scrn_wen = 1;
            scrn_wr_data = uart_rx_data;
            scrn_recv_state = ScrnRecvState::inc;
          }
        }
        escseq::Kind::ICH: {
          scrn_wen = 1;
          scrn_wr_data = 8'h20; // 空白を挿入
          scrn_recv_state = ScrnRecvState::idle;
          // TODO 本来はカーソルより右の文字を右にずらす必要がある
        }
        escseq::Kind::CUU: {
          scrn_wen = 0;
          scrn_wr_pos_line[use_extscrn] -= 1;
          scrn_recv_state = ScrnRecvState::idle;
        }
        escseq::Kind::CUD: {
          scrn_wen = 0;
          scrn_wr_pos_line[use_extscrn] += 1;
          scrn_recv_state = ScrnRecvState::idle;
        }
        escseq::Kind::CUF: {
          let amount: u16 = if es_numbuf_len == 0 ? 1 : es_numbuf[0];
          scrn_wen = 0;
          if scrn_wr_pos_offset[use_extscrn] <: SCRN_W_CHAR - amount {
            scrn_wr_pos_offset[use_extscrn] += amount;
          }
          scrn_recv_state = ScrnRecvState::idle;
        }
        escseq::Kind::CUB: {
          let amount: u16 = if es_numbuf_len == 0 ? 1 : es_numbuf[0];
          scrn_wen = 0;
          if scrn_wr_pos_offset[use_extscrn] >= amount {
            scrn_wr_pos_offset[use_extscrn] -= amount;
          }
          scrn_recv_state = ScrnRecvState::idle;
        }
        escseq::Kind::CNL: {
          scrn_wen = 0;
          scrn_wr_pos_line[use_extscrn] += if es_numbuf_len == 0 ? 1 : es_numbuf[0];
          scrn_wr_pos_offset[use_extscrn] = 0;
          scrn_recv_state = ScrnRecvState::idle;
        }
        escseq::Kind::CPL: {
          scrn_wen = 0;
          scrn_wr_pos_line[use_extscrn] -= if es_numbuf_len == 0 ? 1 : es_numbuf[0];
          scrn_wr_pos_offset[use_extscrn] = 0;
          scrn_recv_state = ScrnRecvState::idle;
        }
        escseq::Kind::CHA: {
          scrn_wen = 0;
          scrn_wr_pos_offset[use_extscrn] = es_numbuf[0] - 1;
          scrn_recv_state = ScrnRecvState::idle;
        }
        escseq::Kind::CUP: {
          let line: bit<SCRN_LINE_WIDTH> =
            (if es_numbuf[0] <= SCRN_H_CHAR ? es_numbuf[0] : SCRN_H_CHAR) - 1;
          let offset: bit<SCRN_OFFSET_WIDTH> =
            (if es_numbuf[1] <= SCRN_W_CHAR ? es_numbuf[1] : SCRN_W_CHAR) - 1;

          scrn_wen = 0;
          case es_numbuf_len {
            1: {
              scrn_wr_pos_line[use_extscrn] = line;
              scrn_wr_pos_offset[use_extscrn] = '0;
            }
            2: {
              scrn_wr_pos_line[use_extscrn] = line;
              scrn_wr_pos_offset[use_extscrn] = offset;
            }
            default: { // home position
              scrn_wr_pos_line[use_extscrn] = '0;
              scrn_wr_pos_offset[use_extscrn] = '0;
            }
          }
          scrn_recv_state = ScrnRecvState::idle;
        }
        escseq::Kind::EL: {
          scrn_wr_data = 0;
          scrn_wen = 1;
          scrn_recv_state = ScrnRecvState::clear;

          if es_numbuf_len == 0 || es_numbuf[0] == 0 {
            // カーソルから右を消去
            scrn_clear_cnt = 127 - scrn_wr_pos_offset[use_extscrn];
            scrn_wr_pos_offset[use_extscrn] = '1;
          } else {
            // not implemented
          }
        }
        escseq::Kind::ECH: {
          scrn_wen = 1;
          scrn_wr_data = 0;
          scrn_recv_state = ScrnRecvState::idle;
        }
        escseq::Kind::DECSC: {
          scrn_wen = 0;
          scrn_wr_pos_line_save = scrn_wr_pos_line[use_extscrn];
          scrn_wr_pos_offset_save = scrn_wr_pos_offset[use_extscrn];
          scrn_recv_state = ScrnRecvState::idle;
        }
        escseq::Kind::DECRC: {
          scrn_wen = 0;
          scrn_wr_pos_line[use_extscrn] = scrn_wr_pos_line_save;
          scrn_wr_pos_offset[use_extscrn] = scrn_wr_pos_offset_save;
          scrn_recv_state = ScrnRecvState::idle;
        }
        escseq::Kind::DECSET: {
          scrn_wen = 0;
          scrn_recv_state = ScrnRecvState::idle;

          case es_numbuf[0] {
            1049: { // XT_EXTSCRN
              use_extscrn = 1;
            }
            default: {
              // pass
            }
          }
        }
        escseq::Kind::DECRST: {
          scrn_wen = 0;
          scrn_recv_state = ScrnRecvState::idle;

          case es_numbuf[0] {
            1049: { // XT_EXTSCRN
              use_extscrn = 0;
            }
            default: {
              // pass
            }
          }
        }
        escseq::Kind::DECSTBM: {
          scrn_wen = 0;
          scrn_recv_state = ScrnRecvState::idle;
          statusline_is_active = 1;
        }
      }
    } else { // !es_recog
      scrn_scroll[use_extscrn] = 0;

      if scrn_recv_state == ScrnRecvState::clear {
        scrn_wr_data = 0;
        if scrn_clear_cnt == 0 {
          scrn_wen = 0;
          scrn_recv_state = ScrnRecvState::idle;
        } else {
          scrn_wen = 1;
          if scrn_wr_pos_offset[use_extscrn] >: 0 {
            scrn_wr_pos_offset[use_extscrn] -= 1;
          }
          scrn_clear_cnt -= 1;
        }
      } else if scrn_recv_state == ScrnRecvState::inc {
        scrn_wen = 0;
        if scrn_wr_pos_offset[use_extscrn] <: SCRN_W_CHAR - 1 {
          // 行末尾を超えて自動改行は現時点でサポートしない
          scrn_wr_pos_offset[use_extscrn] += 1;
        }
        scrn_recv_state = ScrnRecvState::idle;
      }
    }
  }

  var usb_dbg : 'usb bit<16>;
  unsafe (cdc) {
    //assign dbg[15:8] = '0;
    //assign dbg[7:0] = usb_dbg;
    assign dbg = usb_dbg;
  }

  initial {
    $readmemh("../hankaku.hex", font_mem);
  }

  var color_fg: bit<3, 8>; // [0]=B, [1]=G, [2]=R
  var color_bg: bit<3, 8>;
  var color_fg_dvi: 'dvi bit<3, 8>;
  var color_bg_dvi: 'dvi bit<3, 8>;
  inst color_synchronizer: $std::synchronizer_basic #(
    WIDTH: 48,
    STAGES: 2,
  ) (
    i_clk: pclk,
    i_rst: dvi_rst_n,
    i_d: {color_fg, color_bg},
    o_d: {color_fg_dvi, color_bg_dvi},
  );

  let font_pixel_color: 'dvi bit<3, 8> = // B, G, R
    if font_buf[FONT_W - 1 - font_xpos] ? color_fg_dvi : color_bg_dvi;

  // カーソル横位置
  var cursor_line_dvi: 'dvi bit<SCRN_LINE_WIDTH>;
  var cursor_offset_dvi: 'dvi bit<SCRN_OFFSET_WIDTH>;
  let cursor_v: 'dvi bit<PIXEL_WIDTH> = FONT_H * cursor_line_dvi + STATUSLINE_H_PIX;
  let cursor_h: 'dvi bit<PIXEL_WIDTH> = FONT_W * cursor_offset_dvi;

  let pixel_color: 'dvi bit<3, 8> = switch {
    act_pixel_v <: STATUSLINE_H_PIX:
      if statusline_is_active_dvi ? font_pixel_color : color_bg_dvi,
    act_pixel_v <: FONT_H:
      font_pixel_color,
    act_pixel_v <: FONT_H + 1:
      if statusline_is_active_dvi ? color_bg_dvi : font_pixel_color,
    act_pixel_v <: FONT_H + 2:
      if statusline_is_active_dvi ? color_fg_dvi : font_pixel_color,
    act_pixel_v <: FONT_H + STATUSLINE_H_PIX:
      if statusline_is_active_dvi ? color_bg_dvi : font_pixel_color,
    act_pixel_v <: cursor_v:
      font_pixel_color,
    act_pixel_v <: cursor_v + FONT_H:
      if use_extscrn_dvi == 0 &&
        cursor_h <= act_pixel_h && act_pixel_h <: cursor_h + FONT_W
        ? color_fg_dvi
        : font_pixel_color,
    act_pixel_v <: FONT_H * SCRN_H_CHAR + STATUSLINE_H_PIX:
      font_pixel_color,
    default:
      color_bg_dvi,
  };

  always_ff (sys_clk, rst_n) {
    if_reset {
      color_fg = 24'h66FF00;
      color_bg = '0;
    } else if es_recog {
      let col: bit<3, 8> = {es_numbuf[1][7:0], es_numbuf[2][7:0], es_numbuf[3][7:0]};
      case es_kind {
        escseq::Kind::OSC10: color_fg = case es_numbuf[1] {
          16'hFF00: 24'h66FF00, // reset
          default:  col,
        };
        escseq::Kind::OSC11: color_bg = case es_numbuf[1] {
          16'hFF00: '0, // reset
          default:  col,
        };
      }
    }
  }

  inst cursor_pos_synchronizer: $std::synchronizer_basic #(
    WIDTH: SCRN_LINE_WIDTH + SCRN_OFFSET_WIDTH,
    STAGES: 2,
  ) (
    i_clk: pclk,
    i_rst: dvi_rst_n,
    i_d: {scrn_wr_pos_line[0], scrn_wr_pos_offset[0]},
    o_d: {cursor_line_dvi, cursor_offset_dvi},
  );

  var dvi_out_data: 'dvi bit<10>[3];
  inst dvi_out: DviOut (
    clk: pclk,
    rst_n: dvi_rst_n,
    i_color: pixel_color,
    i_de: data_enable,
    i_hsync: state_h == DVIState::sync,
    i_vsync: state_v == DVIState::sync,
    o_data: dvi_out_data,
  );

  // USB
  var usb_clk : 'usb clock;
  var usb_pll_lock : 'usb logic;
  var usb_rst_n : 'usb reset_async_low;
  var status_led : 'usb logic<6>;

  unsafe (cdc) {
    inst usb_pll: $sv::gowin_rpll_usb(
      clkin: sys_clk,
      clkout: usb_clk,
      lock: usb_pll_lock
    );

    assign usb_rst_n = rst_n & usb_pll_lock;
    assign onboard_led = status_led;
    assign usb_vbus_ctrl = usb_rst_n;
  }

  var sw_n : 'usb reset_async_low;
  inst sw_synchronizer: $std::synchronizer_basic #(
    WIDTH: 1,
    STAGES: 2,
  ) (
    i_clk: usb_clk,
    i_rst: usb_rst_n,
    i_d: sw_n_raw,
    o_d: sw_n,
  );

  var sw_n_latch : 'usb bit; // 起動時の sw_n の状態を保持
  var sw_latch_state : 'usb bit<2>;

  always_ff (usb_clk, usb_rst_n) {
    if_reset {
      sw_n_latch = 0;
      sw_latch_state = 0;
    } else {
      case sw_latch_state {
        0,1: {
          sw_latch_state += 1;
        }
        2: {
          sw_n_latch = sw_n;
          sw_latch_state += 1;
        }
        default: {
          sw_latch_state = '1;
        }
      }
    }
  }

  inst usb_inst : usb_host(
    clk: usb_clk,
    rst_n: usb_rst_n,
    status_led,
    dp_raw: usb_dp_raw,
    dm_raw: usb_dm_raw,
    dbg: usb_dbg,
    key_ascii: usb_key_ascii,
    key_req: usb_key_req,
    skip_key_auth: ~sw_n_latch,
    challenge_char: usb_challenge_char,
    challenge_req: usb_challenge_req,
    key_auth_state: usb_key_auth_state,
  );
}


/*
画面制御のパラメタ（CVT-RBv2を採用）

| パラメタ      | CVT   | CVT  | CVT-RB | CVT-RBv2 | Unit   |
| ------------- | ----- | ---- | ------ | -------- | ------ |
| V Frequency   | 59.825| 51.58| 59.695 | 60       | Hz     |
| Pixel Clock   | 49    | 41   | 43.75  | 40.936   | MHz    |
| H Back Porch  | 144   | 128  | 80     | 40       | Pixels |
| H Active      | 1024  | 1024 | 1024   | 1024     | Pixels |
| H Front Porch | 40    | 32   | 48     | 8        | Pixels |
| H Sync        | 104   | 96   | 32     | 32       | Pixels |
| V Back Porch  | 11    | 8    | 6      | 6        | Lines  |
| V Active      | 600   | 600  | 600    | 600      | Lines  |
| V Front Porch | 3     | 3    | 3      | 4        | Lines  |
| V Sync        | 10    | 10   | 10     | 8        | Lines  |
*/

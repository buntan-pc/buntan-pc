module ScreenMemory #(
  param LINE_WIDTH: u8 = 6,
  param OFFSET_WIDTH: u8 = 7,
) (
  clk:    input  clock,
  rst:    input  reset_async_low,
  wen:    input  bit,
  line:   input  bit<LINE_WIDTH>,
  offset: input  bit<OFFSET_WIDTH>,
  din:    input  bit<9>,
  dout:   output bit<9>,

  clk_dvi:    input  'dvi clock,
  rst_dvi:    input  'dvi reset_async_low,
  line_dvi:   input  'dvi bit<LINE_WIDTH>,
  offset_dvi: input  'dvi bit<OFFSET_WIDTH>,
  dout_dvi:   output 'dvi bit<9>,
) {
  const MEM_LEN: u32 = 1 << (LINE_WIDTH + OFFSET_WIDTH);
  var mem: bit<9>[MEM_LEN];
  let addr: bit<LINE_WIDTH + OFFSET_WIDTH> = {line, offset};
  let addr_dvi: 'dvi bit<LINE_WIDTH + OFFSET_WIDTH> = {line_dvi, offset_dvi};

  always_ff (clk, rst) {
    if_reset {
      dout = 0;
    } else if wen {
      mem[addr] = din;
    } else {
      dout = mem[addr];
    }
  }

  unsafe (cdc) {
    always_ff (clk_dvi, rst_dvi) {
      if_reset {
        dout_dvi = 0;
      } else {
        dout_dvi = mem[addr_dvi];
      }
    }
  }
}

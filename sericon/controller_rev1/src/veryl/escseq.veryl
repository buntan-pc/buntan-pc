package escseq {
  enum Kind {
    NONE,
    ICH, // Insert Character
    CUU, // Cursor Up
    CUD, // Cursor Down
    CUF, // Cursor Forward
    CUB, // Cursor Backward
    CNL, // Cursor Next Line
    CPL, // Cursor Previous Line
    CHA, // Cursor Horizontal Absolute
    CUP, // Cursor Position
    EL,  // Erace in Line
    ECH, // Erase Character
    DECSC,
    DECRC,
    DECSET,
    DECRST,
    DECSTBM,
    OSC10, // Change/Query dynamic foreground color
    OSC11, // Change/Query dynamic background color
  }
}

module ESRecognizer #(
  param NUMBUF_LEN: u8 = 4, // 数値バッファの最大個数
) (
  i_clk:    input clock,
  i_rst_n:  input reset_async_low,
  i_char:   input bit<8>, // 受信した文字
  i_char_v: input bit,    // i_char が有効なら 1
  o_recog:  output bit, // エスケープシーケンスの解釈が完了したら 1
  o_kind:   output escseq::Kind, // エスケープシーケンスの種類
  o_numbuf: output u16[NUMBUF_LEN],
  o_numbuf_len: output u8,
) {
  enum Mode {
    INIT,
    ESC,   // ESC
    CSI,   // ESC [
    CSIN,  // CSI number を読み取り中
    CSIQ,  // CSI ?
    OSC,   // ESC ]
    OSCN,  // OSC number を読み取り中
    OSC_COLOR_SPEC_TYPE,  // OSC の色スペックの種別（rgb, rbgi, reset, ?）
    OSC_COLOR_SPEC_VALUE, // 色スペック値を読み取り中
  }

  var es_reading: bit;
  var mode: Mode;

  var numbuf: u16[NUMBUF_LEN];
  var numbuf_ind: u8;

  const COLOR_SPEC_TYPE_LEN: u8 = 5;
  var color_spec_type: bit<COLOR_SPEC_TYPE_LEN, 7>;
  var color_spec_type_ind: u8;

  always_ff (i_clk, i_rst_n) {
    if_reset {
      o_recog = 0;
      o_kind = escseq::Kind::NONE;
      es_reading = 0;
      numbuf_ind = 0;
      mode = Mode::INIT;
      color_spec_type = '{default: '0};
      color_spec_type_ind = 0;
    } else if i_char_v {
      // 正しいエスケープシーケンスのみに対応する
      // 壊れたエスケープシーケンスは考慮しない
      if ~es_reading {
        if i_char == 8'h1B {
          es_reading = 1;
          numbuf[0] = 0;
          numbuf_ind = 0;
          color_spec_type_ind = 0;
          mode = Mode::ESC;
        } else {
          o_recog = 1;
          o_kind = escseq::Kind::NONE;
        }
      } else if mode == Mode::OSC_COLOR_SPEC_TYPE {
        if color_spec_type_ind <: COLOR_SPEC_TYPE_LEN {
          color_spec_type[color_spec_type_ind] = i_char;
          color_spec_type_ind += 1;
        }
        case i_char {
          ":": {
            mode = Mode::OSC_COLOR_SPEC_VALUE;
          }
          8'h07: {
            if color_spec_type_ind == 5 &&
                color_spec_type[0] == "r" &&
                color_spec_type[1] == "e" &&
                color_spec_type[2] == "s" &&
                color_spec_type[3] == "e" &&
                color_spec_type[4] == "t" {
              o_numbuf[1] = 16'hFF00;
              o_recog = 1;
            }
            es_reading = 0;
            mode = Mode::INIT;
          }
        }
      } else if mode == Mode::OSC_COLOR_SPEC_VALUE {
        if i_char == 8'h07 /* BEL */ {
          o_numbuf[numbuf_ind] = numbuf[numbuf_ind];
          o_recog = 1;
          es_reading = 0;
          mode = Mode::INIT;
        } else if i_char == "/" {
          o_numbuf[numbuf_ind] = numbuf[numbuf_ind];
          numbuf[numbuf_ind + 1] = 0;
          numbuf_ind += 1;
        } else if 8'h30 <= i_char && i_char <= 8'h39 { // 0–9
          numbuf[numbuf_ind] = (numbuf[numbuf_ind] << 4) + (i_char - 8'h30);
        } else if 8'h41 <= i_char && i_char <= 8'h46 { // A–F
          numbuf[numbuf_ind] = (numbuf[numbuf_ind] << 4) + (i_char - 8'h41 + 8'h0A);
        } else if 8'h61 <= i_char && i_char <= 8'h66 { // a–f
          numbuf[numbuf_ind] = (numbuf[numbuf_ind] << 4) + (i_char - 8'h61 + 8'h0A);
        }
      } else {
        case i_char {
          8'h30 ..= 8'h39 /* 0-9 */: {
            case mode {
              Mode::ESC: {
                o_recog = 1;
                o_kind = case i_char {
                  8'h37: escseq::Kind::DECSC,
                  8'h38: escseq::Kind::DECRC,
                  default: escseq::Kind::NONE,
                };
                es_reading = 0;
                mode = Mode::INIT;
              }
              Mode::OSC, Mode::OSCN: {
                numbuf[numbuf_ind] = numbuf[numbuf_ind] * 10 + (i_char - 8'h30);
                mode = Mode::OSCN;
              }
              default: {
                numbuf[numbuf_ind] = numbuf[numbuf_ind] * 10 + (i_char - 8'h30);
                mode = Mode::CSIN;
              }
            }
          }
          8'h3B /* ; */: {
            if numbuf_ind == 0 && mode == Mode::OSCN {
              mode = Mode::OSC_COLOR_SPEC_TYPE;
              o_kind = case numbuf[0] {
                10:      escseq::Kind::OSC10,
                default: escseq::Kind::OSC11,
              };
            } else {
              mode = Mode::CSI;
            }

            o_numbuf[numbuf_ind] = numbuf[numbuf_ind];
            numbuf[numbuf_ind + 1] = 0;
            numbuf_ind += 1;
          }
          8'h3F /* ? */: {
            mode = Mode::CSIQ;
          }
          8'h5B /* [ */: {
            mode = Mode::CSI;
          }
          8'h5D /* ] */: {
            mode = Mode::OSC;
          }
          default: /* A-Z, a-z */ {
            o_recog = 1;
            o_kind = case i_char {
              8'h40 /* @ */: escseq::Kind::ICH,
              8'h41 /* A */: escseq::Kind::CUU,
              8'h42 /* B */: escseq::Kind::CUD,
              8'h43 /* C */: escseq::Kind::CUF,
              8'h44 /* D */: escseq::Kind::CUB,
              8'h45 /* E */: escseq::Kind::CNL,
              8'h46 /* F */: escseq::Kind::CPL,
              8'h47 /* G */: escseq::Kind::CHA,
              8'h48 /* H */: escseq::Kind::CUP,
              8'h4B /* K */: escseq::Kind::EL,
              8'h58 /* X */: escseq::Kind::ECH,
              8'h68 /* h */: escseq::Kind::DECSET,
              8'h6C /* l */: escseq::Kind::DECRST,
              8'h72 /* r */: escseq::Kind::DECSTBM,
              default:       escseq::Kind::NONE,
            };
            if mode == Mode::CSIN {
              o_numbuf[numbuf_ind] = numbuf[numbuf_ind];
              o_numbuf_len = numbuf_ind + 1;
            } else {
              o_numbuf_len = numbuf_ind;
            }
            es_reading = 0;
            mode = Mode::INIT;
          }
        }
      }
    } else {
      o_recog = 0;
    }
  }
}

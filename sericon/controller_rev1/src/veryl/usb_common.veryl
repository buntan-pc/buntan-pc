package usb {
  enum BusState: bit<_> {
    J,   // ドライバを Hi-Z にしたときの自然状態（LS なら D0、FS なら D1）
    K,   // J の逆状態
    L0,  // Logic 0
    L1,  // Logic 1
    SE0, // Single Ended 0
    SE1, // Single Ended 1
  }

  enum DevSpeed: bit<2> {
    NoDevice, // 0
    LS,       // 1
    FS,       // 2
  }

  enum PID: bit<4> {
    OUT   = 4'b0001,
    IN    = 4'b1001,
    SOF   = 4'b0101,
    SETUP = 4'b1101,
    DATA0 = 4'b0011,
    DATA1 = 4'b1011,
    DATA2 = 4'b0111,
    MDATA = 4'b1111,
    ACK   = 4'b0010,
    NACK  = 4'b1010,
    STALL = 4'b1110,
    NYET  = 4'b0110,
    ERR   = 4'b1100,
    SPLIT = 4'b1000,
    PING  = 4'b0100,
  }

  enum DevReq: bit<8> {
    SET_ADDRESS    = 5,
    GET_DESCRIPTOR = 6,
  }

  enum DescType: bit<_> {
    Device        = 1,
    Configuration = 2,
    String        = 3,
    Interface     = 4,
    Endpoint      = 5,
  }
}

import usb::*;
import usb::BusState::*;
import usb::DevReq::*;

module usb_host #(
  param CLOCK_HZ: u32 = 48_000_000,
) (
  clk: input clock,
  rst_n: input reset_async_low,
  status_led: output logic<6>,
  dp_raw: inout 'usb_raw tri logic,
  dm_raw: inout 'usb_raw tri logic,
  dbg: output bit<16>,
) {
  var dir_out : bit;

  const MS_TICK_PERIOD: u32 = CLOCK_HZ / 1000;
  var ms_tick_gen : bit<$clog2(MS_TICK_PERIOD)>; // 1ms 周期を作り出すタイマ
  var ms_tick : bit; // 1ms 周期で 1 クロック幅だけ 1 になるイネーブル信号

  always_ff (clk, rst_n) {
    if_reset {
      ms_tick_gen = 0;
      ms_tick = 0;
    } else if ms_tick_gen == MS_TICK_PERIOD - 1 {
      ms_tick_gen = 0;
      ms_tick = 1;
    } else {
      ms_tick_gen += 1;
      ms_tick = 0;
    }
  }

  var packet_send_req : bit;
  var nrzi_out : bit;

  const LS_BIT_PERIOD : u32 = CLOCK_HZ/1_500_000;
  var ls_tick_gen : bit<$clog2(LS_BIT_PERIOD - 1)>; // LS のビットタイミング 1.5Mbps を作るタイマ
  var ls_tick : bit; // ビット先頭で 1 クロック期間だけ 1 になる

  always_ff (clk, rst_n) {
    if_reset {
      ls_tick_gen = 0;
      ls_tick = 0;
    } else if ls_tick_gen == LS_BIT_PERIOD - 1 {
      ls_tick_gen = 0;
      ls_tick = 1;
    } else {
      ls_tick_gen += 1;
      ls_tick = 0;
    }
  }

  var dev_speed : DevSpeed;
  var dev_en : bit;
  var sig_out : BusState;
  var valid_out : bit;
  var sig_in : BusState;
  var valid_in : bit;
  inst bus : usb_bus #(
    CLOCK_HZ,
  ) (
    clk,
    rst_n,
    ms_tick,
    dev_speed,
    dev_en,
    dp_raw,
    dm_raw,
    dir_h2d: dir_out,
    sig_h2d: sig_out,
    valid_h2d: valid_out,
    sig_d2h: sig_in,
    valid_d2h: valid_in,
  );

  // PP: PacketPayload
  struct PP_Setup {
    resv: bit<53>,
    endp: bit<4>,
    addr: bit<7>,
  }
  struct PP_SetupData {
    wLength: u16,
    wIndex: u16,
    wValue: u16,
    bRequest: u8,
    bmRequestType: u8,
  }
  struct Packet {
    pid: PID,
    payload: bit<64>,
    payload_len: u8,
  }

  enum CommandKind {
    SendPacket,
    RecvPacket,
    Other,
  }
  enum CID: bit<4> { // Command ID
    Delay,
  }
  struct Command {
    kind: CommandKind,
    data: Packet,
  }

  const NUM_INITIAL_COMMAND : u8 = 10;
  let dev_addr: bit<7> = 6;
  let commands : Command[NUM_INITIAL_COMMAND] = '{
    // Setup stage
    Command'{ // 0
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::SETUP,
                    payload: PP_Setup'{addr: 0, endp: 0, resv: 0},
                    payload_len: 11},
    },
    Command'{ // 1
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::DATA0,
                    payload: PP_SetupData'{bmRequestType: 0,
                                           bRequest: SET_ADDRESS,
                                           wValue: dev_addr,
                                           wIndex: 0, wLength: 0},
                    payload_len: 64},
    },
    Command'{ // 2
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_len: 0},
    },

    // Data stage (none)

    // Status stage
    Command'{ // 3
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::IN, // Data stage が無い場合は IN
                    payload: PP_Setup'{addr: 0, endp: 0, resv: 0},
                    payload_len: 11},
    },
    Command'{ // 4
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::DATA1, payload: '0, payload_len: 0},
    },
    Command'{ // 5
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_len: 0},
    },

    // Delay >= 2ms
    Command'{ // 6
      kind: CommandKind::Other,
      data: Packet'{pid: CID::Delay as PID, payload: 2, payload_len: 8},
    },

    // Setup stage
    Command'{ // 7
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::SETUP,
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_len: 11},
    },
    Command'{ // 8
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::DATA0,
                    payload: PP_SetupData'{bmRequestType: 8'b10000000,
                                           bRequest: GET_DESCRIPTOR,
                                           wValue: DescType::Device << 8 | 0,
                                           wIndex: 0,
                                           wLength: 16'd18},
                    payload_len: 64},
    },
    Command'{ // 9
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_len: 0},
    },
  };
  let commands_len : u8 = NUM_INITIAL_COMMAND;
  var command_index : u8;
  var next_command_index : u8;
  var command_cache : Command;
  var recv_packet : Packet;

  // 各トランザクションの先頭のコマンド番号
  let transaction : u8[5] = '{0, 3, 6, 7, 255};
  var transaction_index : u8;

  enum CommandState {
    Ready,
    Exec,
    Next,
  }

  enum PacketState: bit<3> {
    Ready, // 0
    Sync,
    PID,
    Data,
    CRC5,
    CRC16,
    EOP,
    Error, // 7
  }

  var command_state : CommandState;
  var packet_state : PacketState;
  var bit_cnt : u8;

  var crc5 : bit<5>;
  var crc16 : bit<16>;
  var use_crc5 : bit; // 1=CRC5 0=CRC16
  var sync_buf : bit<8>;
  var pid_buf : bit<4>;

  always_ff (clk, rst_n) {
    if_reset {
      command_index = 0;
      next_command_index = 0;
      transaction_index = 0;
      command_state = CommandState::Ready;
      command_cache = '0;
    } else {
      case command_state {
        CommandState::Ready: {
          // commands[command_index] をそのまま使うとクリティカルパスが
          // 長くなりすぎるので、キャッシュしてそれを使う。
          command_cache = commands[command_index];
          next_command_index = command_index + 1;
          if command_index >= transaction[transaction_index + 1] {
            transaction_index += 1;
          }

          if dev_en && command_index <: commands_len {
            command_state = CommandState::Exec;
          } else if ~dev_en {
            command_index = 0;
            transaction_index = 0;
          }
        }
        CommandState::Exec: {
          case command_cache.kind {
            CommandKind::SendPacket: {
              if packet_state == PacketState::EOP && bit_cnt >= 4 {
                command_state = CommandState::Next;
              }
            }
            CommandKind::RecvPacket: {
              if packet_state == PacketState::PID &&
                 recv_packet.pid != command_cache.data.pid {
                // トランザクションをやりなおす
                next_command_index = transaction[transaction_index];
              }
              if packet_state == PacketState::EOP && bit_cnt >= 4 {
                command_state = CommandState::Next;
              }
            }
            CommandKind::Other: {
              if bit_cnt >= command_cache.data.payload[7:0] {
                command_state = CommandState::Next;
              }
            }
          }
        }
        CommandState::Next: {
          command_state = CommandState::Ready;
          command_index = next_command_index;
        }
      }
    }
  }

  always_ff (clk, rst_n) {
    if_reset {
      packet_state = PacketState::Ready;
      dir_out = 0;
      sig_out = J;
      bit_cnt = 0;
      crc5 = '1;
      crc16 = '1;
    } else if command_state == CommandState::Ready {
      packet_state = PacketState::Ready;
      bit_cnt = 0;
      crc5 = '1;
      crc16 = '1;
    } else if command_state == CommandState::Next {
    } else if command_cache.kind == CommandKind::Other {
      case command_cache.data.pid {
        CID::Delay: {
          if ms_tick {
            bit_cnt += 1;
          }
        }
        default: {
        }
      }
    } else if command_cache.kind == CommandKind::SendPacket {
      case packet_state {
        PacketState::Ready: {
          packet_state = PacketState::Sync;
          dir_out = 1;
        }
        PacketState::Sync: {
          use_crc5 = (command_cache.data.pid & 4'b0011) != 4'b0011;
          if ls_tick {
            if bit_cnt <: 7 {
              bit_cnt += 1;
              sig_out = L0;
            } else {
              packet_state = PacketState::PID;
              bit_cnt = 0;
              sig_out = L1;
            }
          }
        }
        PacketState::PID:
          if ls_tick {
            if bit_cnt <: 4 {
              sig_out = if command_cache.data.pid[bit_cnt] ? L1 : L0;
              bit_cnt += 1;
            } else if bit_cnt <: 8 {
              sig_out = if command_cache.data.pid[bit_cnt - 4] ? L0 : L1;
              if bit_cnt == 7 {
                if command_cache.data.payload_len == 0 {
                  packet_state = PacketState::EOP;
                } else {
                  packet_state = PacketState::Data;
                }
                bit_cnt = 0;
              } else {
                bit_cnt += 1;
              }
            }
          }
        PacketState::Data:
          if ls_tick {
            var next_bit : bit;
            next_bit = command_cache.data.payload[bit_cnt];
            sig_out = if next_bit ? L1 : L0;

            // x^5 + x^2 + x^0
            let fb5 : bit = next_bit ^ crc5[0];
            crc5[0] = crc5[1];
            crc5[1] = crc5[2];
            crc5[2] = crc5[3] ^ fb5;
            crc5[3] = crc5[4];
            crc5[4] = fb5;

            // x^16 + x^15 + x^2 + x^0
            let fb16 : bit = next_bit ^ crc16[0];
            crc16[0]  = crc16[1] ^ fb16;
            crc16[1]  = crc16[2];
            crc16[2]  = crc16[3];
            crc16[3]  = crc16[4];
            crc16[4]  = crc16[5];
            crc16[5]  = crc16[6];
            crc16[6]  = crc16[7];
            crc16[7]  = crc16[8];
            crc16[8]  = crc16[9];
            crc16[9]  = crc16[10];
            crc16[10] = crc16[11];
            crc16[11] = crc16[12];
            crc16[12] = crc16[13];
            crc16[13] = crc16[14] ^ fb16;
            crc16[14] = crc16[15];
            crc16[15] = fb16;

            if bit_cnt == command_cache.data.payload_len - 1 {
              packet_state = if use_crc5
                              ? PacketState::CRC5
                              : PacketState::CRC16;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::CRC5:
          if ls_tick {
            sig_out = if crc5[bit_cnt] ? L0 : L1;
            if bit_cnt == 5 - 1 {
              packet_state = PacketState::EOP;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::CRC16:
          if ls_tick {
            sig_out = if crc16[bit_cnt] ? L0 : L1;
            if bit_cnt == 16 - 1 {
              packet_state = PacketState::EOP;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::EOP:
          if ls_tick {
            case bit_cnt {
              0,1: {
                sig_out = SE0;
                bit_cnt += 1;
              }
              2: {
                sig_out = J;
                bit_cnt += 1;
              }
              default: {
                dir_out = 0;
                bit_cnt = 4;
              }
            }
          }
        }
    } else { // RecvPacket
      case packet_state {
        PacketState::Ready: {
          packet_state = PacketState::Sync;
          dir_out = 0;
        }
        PacketState::Sync:
          if valid_in {
            sync_buf[bit_cnt] = if sig_in == L0 ? 0 : 1;
            bit_cnt += 1;
          } else if bit_cnt == 8 {
            if sync_buf == 8'h80 {
              packet_state = PacketState::PID;
              bit_cnt = 0;
            } else {
              packet_state = PacketState::Error;
            }
          }
        PacketState::PID:
          if valid_in {
            if bit_cnt <: 4 {
              recv_packet.pid[bit_cnt] = if sig_in == L0 ? 0 : 1;
              bit_cnt += 1;
            } else {
              pid_buf[bit_cnt - 4] = if sig_in == L0 ? 0 : 1;
              bit_cnt += 1;
            }
          } else if bit_cnt == 8 {
            if recv_packet.pid != ~pid_buf {
              packet_state = PacketState::Error;
            } else {
              packet_state = PacketState::Data;
              bit_cnt = 0;
              recv_packet.payload_len = case recv_packet.pid {
                PID::ACK: 0,
                default: 0,
              };
            }
          }
        PacketState::Data:
          if valid_in {
            if sig_in == SE0 {
              packet_state = PacketState::EOP;
              bit_cnt = 1;
            } else {
              recv_packet.payload[bit_cnt] = if sig_in == L0 ? 0 : 1;
              bit_cnt += 1;
            }
          }
        PacketState::EOP:
          if valid_in {
            case bit_cnt {
              0,1: {
                if sig_in == SE0 {
                  bit_cnt += 1;
                } else {
                  packet_state = PacketState::Error;
                }
              }
              2: {
                if sig_in == J {
                  bit_cnt += 1;
                } else {
                  packet_state = PacketState::Error;
                }
              }
              default: {
                bit_cnt = 4;
              }
            }
          }
        PacketState::Error: {
        }
      }
    }
  }

  always_ff (clk, rst_n) {
    if_reset {
      valid_out = 0;
    } else if ls_tick {
      valid_out = dir_out;
    } else {
      valid_out = 0;
    }
  }

  var tick_toggle : logic;
  always_ff (clk, rst_n) {
    if_reset {
      tick_toggle = 0;
    } else if (ms_tick) {
      tick_toggle = ~tick_toggle;
    }
  }

  assign status_led = {~packet_state, ~dev_speed};
  assign dbg = {command_index[4:0], sig_in, packet_state, command_state, valid_in, 2'0};
}

import usb::*;
import usb::BusState::*;

module usb_host #(
  param CLOCK_HZ: u32 = 96_000_000,
) (
  clk: input clock,
  rst_n: input reset_async_low,
  status_led: output logic<6>,
  dp_raw: inout 'usb_raw tri logic,
  dm_raw: inout 'usb_raw tri logic,
  dbg: output bit<8>,
) {
  var dir_out : bit;

  const MS_TICK_PERIOD: u32 = CLOCK_HZ / 1000;
  var ms_tick_gen : bit<$clog2(MS_TICK_PERIOD)>; // 1ms 周期を作り出すタイマ
  var ms_tick : bit; // 1ms 周期で 1 クロック幅だけ 1 になるイネーブル信号

  always_ff (clk, rst_n) {
    if_reset {
      ms_tick_gen = 0;
      ms_tick = 0;
    } else if ms_tick_gen == MS_TICK_PERIOD - 1 {
      ms_tick_gen = 0;
      ms_tick = 1;
    } else {
      ms_tick_gen += 1;
      ms_tick = 0;
    }
  }

  var packet_send_req : bit;
  var nrzi_out : bit;

  enum DeviceRequest: bit<8> {
    SET_ADDRESS = 5,
  }
  var device_request : DeviceRequest;

  const LS_BIT_PERIOD : u32 = CLOCK_HZ/1_500_000;
  var ls_tick_gen : bit<$clog2(LS_BIT_PERIOD - 1)>; // LS のビットタイミング 1.5Mbps を作るタイマ
  var ls_tick : bit; // ビット先頭で 1 クロック期間だけ 1 になる

  always_ff (clk, rst_n) {
    if_reset {
      ls_tick_gen = 0;
      ls_tick = 0;
    } else if ls_tick_gen == LS_BIT_PERIOD - 1 {
      ls_tick_gen = 0;
      ls_tick = 1;
    } else {
      ls_tick_gen += 1;
      ls_tick = 0;
    }
  }

  var dev_speed : DevSpeed;
  var dev_en : bit;
  var sig_out : BusState;
  inst bus : usb_bus #(
    CLOCK_HZ,
  ) (
    clk,
    rst_n,
    bit_tick: ls_tick,
    ms_tick,
    dev_speed,
    dev_en,
    dp_raw,
    dm_raw,
    dir_h2d: dir_out,
    sig_h2d: sig_out,
  );

  struct Packet {
    pid : PID,
    data : bit<64>,
    data_len : u8,
  }
  let packets_to_send : Packet[2] = '{
    Packet'{pid: PID::SETUP, data: {53'0, 4'h3, 7'h12}, data_len: 11},
    Packet'{pid: PID::DATA0, data: {8'h00, 8'h5, 16'h41, 16'h0, 16'h0}, data_len: 64},
  };
  let packets_len : u8 = 2;
  var packet_index : u8;
  var packet_cache : Packet;

  enum PacketState: bit<_> {
    Idle,
    Ready,
    Sync,
    PID,
    Data,
    CRC5,
    EOP,
  }
  var packet_state : PacketState;
  var bit_cnt : u8;

  var crc5 : bit<5>;

  always_ff (clk, rst_n) {
    if_reset {
      packet_index = 0;
      packet_state = PacketState::Idle;
      dir_out = 0;
      sig_out = J;
    } else {
      case packet_state {
        PacketState::Idle: {
          if dev_en && packet_index <: packets_len {
            packet_state = PacketState::Ready;
            sig_out = J;
            bit_cnt = 0;
            crc5 = '1;
          } else if ~dev_en {
            packet_index = 0;
          }
        }
        PacketState::Ready: {
          packet_state = PacketState::Sync;
          dir_out = 1; // sig_out=J をした後に出力モードにする

          // packets_to_send[packet_index] をそのまま使うとクリティカルパスが
          // 長くなりすぎるので、キャッシュしてそれを使う。
          packet_cache = packets_to_send[packet_index];
        }
        PacketState::Sync:
          if ls_tick {
            if bit_cnt <: 7 {
              bit_cnt += 1;
              sig_out = D0;
            } else {
              packet_state = PacketState::PID;
              bit_cnt = 0;
              sig_out = D1;
            }
          }
        PacketState::PID:
          if ls_tick {
            if bit_cnt <: 4 {
              sig_out = if packet_cache.pid[bit_cnt] ? D1 : D0;
              bit_cnt += 1;
            } else if bit_cnt <: 8 {
              sig_out = if packet_cache.pid[bit_cnt - 4] ? D0 : D1;
              if bit_cnt == 7 {
                if packet_cache.data_len == 0 {
                  packet_state = PacketState::EOP;
                } else {
                  packet_state = PacketState::Data;
                }
                bit_cnt = 0;
              } else {
                bit_cnt += 1;
              }
            }
          }
        PacketState::Data:
          if ls_tick {
            var next_bit : bit;
            next_bit = packet_cache.data[bit_cnt];
            sig_out = if next_bit ? D1 : D0;

            let feedback : bit = next_bit ^ crc5[0];
            crc5[0] = crc5[1];
            crc5[1] = crc5[2];
            crc5[2] = crc5[3] ^ feedback;
            crc5[3] = crc5[4];
            crc5[4] = feedback;

            if bit_cnt == packet_cache.data_len - 1 {
              packet_state = PacketState::CRC5;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::CRC5:
          if ls_tick {
            sig_out = if crc5[bit_cnt] ? D0 : D1;
            if bit_cnt == 5 - 1 {
              packet_state = PacketState::EOP;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::EOP:
          if ls_tick {
            case bit_cnt {
              0,1: {
                sig_out = SE0;
                bit_cnt += 1;
              }
              2: {
                sig_out = J;
                bit_cnt += 1;
              }
              3: {
                dir_out = 0;
                bit_cnt = 4;
              }
              default: {
                packet_state = PacketState::Idle;
                if packet_index <: packets_len {
                  packet_index += 1;
                }
              }
            }
          }
      }
    }
  }

  var tick_toggle : logic;
  always_ff (clk, rst_n) {
    if_reset {
      tick_toggle = 0;
    } else if (ms_tick) {
      tick_toggle = ~tick_toggle;
    }
  }

  assign status_led = {~dev_en, ~packet_state, ~dev_speed};
  assign dbg = {dev_en, packet_state, tick_toggle, 3'0};
}

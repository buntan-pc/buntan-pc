import usb::*;
import usb::BusState::*;
import usb::DevReq::*;

module usb_host #(
  param CLOCK_HZ: u32 = 48_000_000,
) (
  clk: input clock,
  rst_n: input reset_async_low,
  status_led: output logic<6>,
  dp_raw: inout 'usb_raw tri logic,
  dm_raw: inout 'usb_raw tri logic,
  dbg: output bit<8>,
) {
  var dir_out : bit;

  const MS_TICK_PERIOD: u32 = CLOCK_HZ / 1000;
  var ms_tick_gen : bit<$clog2(MS_TICK_PERIOD)>; // 1ms 周期を作り出すタイマ
  var ms_tick : bit; // 1ms 周期で 1 クロック幅だけ 1 になるイネーブル信号

  always_ff (clk, rst_n) {
    if_reset {
      ms_tick_gen = 0;
      ms_tick = 0;
    } else if ms_tick_gen == MS_TICK_PERIOD - 1 {
      ms_tick_gen = 0;
      ms_tick = 1;
    } else {
      ms_tick_gen += 1;
      ms_tick = 0;
    }
  }

  var packet_send_req : bit;
  var nrzi_out : bit;

  const LS_BIT_PERIOD : u32 = CLOCK_HZ/1_500_000;
  var ls_tick_gen : bit<$clog2(LS_BIT_PERIOD - 1)>; // LS のビットタイミング 1.5Mbps を作るタイマ
  var ls_tick : bit; // ビット先頭で 1 クロック期間だけ 1 になる

  always_ff (clk, rst_n) {
    if_reset {
      ls_tick_gen = 0;
      ls_tick = 0;
    } else if ls_tick_gen == LS_BIT_PERIOD - 1 {
      ls_tick_gen = 0;
      ls_tick = 1;
    } else {
      ls_tick_gen += 1;
      ls_tick = 0;
    }
  }

  var dev_speed : DevSpeed;
  var dev_en : bit;
  var sig_out : BusState;
  var sig_in : BusState;
  inst bus : usb_bus #(
    CLOCK_HZ,
  ) (
    clk,
    rst_n,
    bit_tick: ls_tick,
    ms_tick,
    dev_speed,
    dev_en,
    dp_raw,
    dm_raw,
    dir_h2d: dir_out,
    sig_h2d: sig_out,
    sig_d2h: sig_in,
  );

  // PP: PacketPayload
  struct PP_Setup {
    resv: bit<53>,
    endp: bit<4>,
    addr: bit<7>,
  }
  struct PP_SetupData {
    wLength: u16,
    wIndex: u16,
    wValue: u16,
    bRequest: u8,
    bmRequestType: u8,
  }
  struct Packet {
    h2d: bit,
    pid: PID,
    payload: bit<64>,
    payload_len: u8,
  }

  let dev_addr: bit<7> = 6;
  let packets_to_send : Packet[5] = '{
    Packet'{h2d: 1, pid: PID::SETUP,
            payload: PP_Setup'{addr: 0, endp: 0, resv: 0},
            payload_len: 11},
    Packet'{h2d: 1, pid: PID::DATA0,
            payload: PP_SetupData'{bmRequestType: 0,
                                   bRequest: SET_ADDRESS,
                                   wValue: dev_addr, wIndex: 0, wLength: 0},
            payload_len: 64},
    Packet'{h2d: 0, pid: PID::ACK, payload: '0, payload_len: 0},
    Packet'{h2d: 1, pid: PID::SETUP,
            payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
            payload_len: 11},
    Packet'{h2d: 1, pid: PID::DATA0,
            payload: PP_SetupData'{bmRequestType: 8'b10000000,
                                   bRequest: GET_DESCRIPTOR,
                                   wValue: DescType::Device << 8 | 0, wIndex: 0, wLength: 16'd18},
            payload_len: 64},
  };
  let packets_len : u8 = 5;
  var packet_index : u8;
  var packet_cache : Packet;

  enum PacketState: bit<_> {
    Idle, // 0
    Ready,
    Sync,
    PID,
    Data,
    CRC5,
    CRC16,
    EOP,
    RecvSync, // 8
    RecvPID,
    RecvData,
    RecvCRC5,
    RecvCRC16,
    RecvEOP,
  }
  var packet_state : PacketState;
  var bit_cnt : u8;

  var crc5 : bit<5>;
  var crc16 : bit<16>;
  var use_crc5 : bit; // 1=CRC5 0=CRC16
  var sig_in_prev : BusState;
  var recv_tim : bit<$clog2(CLOCK_HZ / 1_500_000)>;
  var recv_now : bit;
  var sync_buf : bit<8>;

  always_ff (clk, rst_n) {
    if_reset {
      sig_in_prev = SE0;
      recv_tim = '0;
      recv_now = 0;
    } else {
      if sig_in_prev == sig_in {
        if recv_tim <: '1 {
          recv_tim += 1;
        }
      } else {
        recv_tim = '0;
      }
      if dev_speed == DevSpeed::LS && recv_tim == CLOCK_HZ / 1_500_000 / 2 {
        recv_now = 1;
      } else if dev_speed == DevSpeed::FS && recv_tim == CLOCK_HZ / 12_000_000 / 2 {
        recv_now = 1;
      } else {
        recv_now = 0;
      }
      sig_in_prev = sig_in;
    }
  }

  always_ff (clk, rst_n) {
    if_reset {
      packet_index = 0;
      packet_state = PacketState::Idle;
      dir_out = 0;
      sig_out = J;
    } else {
      case packet_state {
        PacketState::Idle: {
          if dev_en && packet_index <: packets_len {
            packet_state = PacketState::Ready;
            sig_out = J;
            bit_cnt = 0;
            crc5 = '1;
            crc16 = '1;
          } else if ~dev_en {
            packet_index = 0;
          }
        }
        PacketState::Ready: {
          if packets_to_send[packet_index].h2d {
            packet_state = PacketState::Sync;
            dir_out = 1; // sig_out=J をした後に出力モードにする

            // packets_to_send[packet_index] をそのまま使うとクリティカルパスが
            // 長くなりすぎるので、キャッシュしてそれを使う。
            packet_cache = packets_to_send[packet_index];
          } else {
            packet_state = PacketState::RecvSync;
            dir_out = 0;
            packet_cache = '0;
          }
        }
        PacketState::Sync: {
          use_crc5 = packet_cache.pid == PID::DATA0 ||
                     packet_cache.pid == PID::DATA1;
          if ls_tick {
            if bit_cnt <: 7 {
              bit_cnt += 1;
              sig_out = D0;
            } else {
              packet_state = PacketState::PID;
              bit_cnt = 0;
              sig_out = D1;
            }
          }
        }
        PacketState::PID:
          if ls_tick {
            if bit_cnt <: 4 {
              sig_out = if packet_cache.pid[bit_cnt] ? D1 : D0;
              bit_cnt += 1;
            } else if bit_cnt <: 8 {
              sig_out = if packet_cache.pid[bit_cnt - 4] ? D0 : D1;
              if bit_cnt == 7 {
                if packet_cache.payload_len == 0 {
                  packet_state = PacketState::EOP;
                } else {
                  packet_state = PacketState::Data;
                }
                bit_cnt = 0;
              } else {
                bit_cnt += 1;
              }
            }
          }
        PacketState::Data:
          if ls_tick {
            var next_bit : bit;
            next_bit = packet_cache.payload[bit_cnt];
            sig_out = if next_bit ? D1 : D0;

            // x^5 + x^2 + x^0
            let fb5 : bit = next_bit ^ crc5[0];
            crc5[0] = crc5[1];
            crc5[1] = crc5[2];
            crc5[2] = crc5[3] ^ fb5;
            crc5[3] = crc5[4];
            crc5[4] = fb5;

            // x^16 + x^15 + x^2 + x^0
            let fb16 : bit = next_bit ^ crc16[0];
            crc16[0]  = crc16[1] ^ fb16;
            crc16[1]  = crc16[2];
            crc16[2]  = crc16[3];
            crc16[3]  = crc16[4];
            crc16[4]  = crc16[5];
            crc16[5]  = crc16[6];
            crc16[6]  = crc16[7];
            crc16[7]  = crc16[8];
            crc16[8]  = crc16[9];
            crc16[9]  = crc16[10];
            crc16[10] = crc16[11];
            crc16[11] = crc16[12];
            crc16[12] = crc16[13];
            crc16[13] = crc16[14] ^ fb16;
            crc16[14] = crc16[15];
            crc16[15] = fb16;

            if bit_cnt == packet_cache.payload_len - 1 {
              packet_state = if use_crc5
                              ? PacketState::CRC16
                              : PacketState::CRC5;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::CRC5:
          if ls_tick {
            sig_out = if crc5[bit_cnt] ? D0 : D1;
            if bit_cnt == 5 - 1 {
              packet_state = PacketState::EOP;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::CRC16:
          if ls_tick {
            sig_out = if crc16[bit_cnt] ? D0 : D1;
            if bit_cnt == 16 - 1 {
              packet_state = PacketState::EOP;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::EOP:
          if ls_tick {
            case bit_cnt {
              0,1: {
                sig_out = SE0;
                bit_cnt += 1;
              }
              2: {
                sig_out = J;
                bit_cnt += 1;
              }
              3: {
                dir_out = 0;
                bit_cnt = 4;
              }
              default: {
                packet_state = PacketState::Idle;
                if packet_index <: packets_len {
                  packet_index += 1;
                }
              }
            }
          }
        PacketState::RecvSync:
          if recv_now {
            if bit_cnt <: 8 {
              sync_buf[bit_cnt] = if sig_in == D0 ? 0 : 1;
              bit_cnt += 1;
            }
          } else if bit_cnt == 8 {
            if sync_buf == 8'h80 {
              packet_state = PacketState::RecvPID;
              bit_cnt = 0;
            }
          }
        PacketState::RecvPID:
          if recv_now {
            packet_state = PacketState::Idle;
          }
      }
    }
  }

  var tick_toggle : logic;
  always_ff (clk, rst_n) {
    if_reset {
      tick_toggle = 0;
    } else if (ms_tick) {
      tick_toggle = ~tick_toggle;
    }
  }

  assign status_led = {~packet_state, ~dev_speed};
  assign dbg = {packet_state, tick_toggle, 3'0};
}

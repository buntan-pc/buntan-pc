import usb::*;
import usb::BusState::*;
import usb::DevReq::*;

module usb_host #(
  param CLOCK_HZ: u32 = 48_000_000,
) (
  clk: input clock,
  rst_n: input reset_async_low,
  status_led: output logic<6>,
  dp_raw: inout 'usb_raw tri logic,
  dm_raw: inout 'usb_raw tri logic,
  dbg: output bit<16>,
) {
  var dir_out : bit;

  const MS_TICK_PERIOD: u32 = CLOCK_HZ / 1000;
  var ms_tick_gen : bit<$clog2(MS_TICK_PERIOD)>; // 1ms 周期を作り出すタイマ
  var ms_tick : bit; // 1ms 周期で 1 クロック幅だけ 1 になるイネーブル信号

  always_ff (clk, rst_n) {
    if_reset {
      ms_tick_gen = 0;
      ms_tick = 0;
    } else if ms_tick_gen == MS_TICK_PERIOD - 1 {
      ms_tick_gen = 0;
      ms_tick = 1;
    } else {
      ms_tick_gen += 1;
      ms_tick = 0;
    }
  }

  var packet_send_req : bit;
  var nrzi_out : bit;

  const LS_BIT_PERIOD : u32 = CLOCK_HZ/1_500_000;
  var ls_tick_gen : bit<$clog2(LS_BIT_PERIOD - 1)>; // LS のビットタイミング 1.5Mbps を作るタイマ
  var ls_tick : bit; // ビット先頭で 1 クロック期間だけ 1 になる

  always_ff (clk, rst_n) {
    if_reset {
      ls_tick_gen = 0;
      ls_tick = 0;
    } else if ls_tick_gen == LS_BIT_PERIOD - 1 {
      ls_tick_gen = 0;
      ls_tick = 1;
    } else {
      ls_tick_gen += 1;
      ls_tick = 0;
    }
  }

  var dev_speed : DevSpeed;
  var dev_en : bit;
  var sig_out : BusState;
  var valid_out : bit;
  var sig_in : BusState;
  var valid_in : bit;
  inst bus : usb_bus #(
    CLOCK_HZ,
  ) (
    clk,
    rst_n,
    ms_tick,
    dev_speed,
    dev_en,
    dp_raw,
    dm_raw,
    dir_h2d: dir_out,
    sig_h2d: sig_out,
    valid_h2d: valid_out,
    sig_d2h: sig_in,
    valid_d2h: valid_in,
  );

  // PP: PacketPayload
  struct PP_Setup {
    resv: bit<53>,
    endp: bit<4>,
    addr: bit<7>,
  }
  struct PP_SetupData {
    wLength: u16,
    wIndex: u16,
    wValue: u16,
    bRequest: u8,
    bmRequestType: u8,
  }
  struct Packet {
    h2d: bit,
    pid: PID,
    payload: bit<64>,
    payload_len: u8,
  }

  const NUM_INITIAL_PACKET : u8 = 9;
  let dev_addr: bit<7> = 6;
  let packets_to_send : Packet[NUM_INITIAL_PACKET] = '{
    // Setup stage
    Packet'{h2d: 1, pid: PID::SETUP,
            payload: PP_Setup'{addr: 0, endp: 0, resv: 0},
            payload_len: 11},
    Packet'{h2d: 1, pid: PID::DATA0,
            payload: PP_SetupData'{bmRequestType: 0,
                                   bRequest: SET_ADDRESS,
                                   wValue: dev_addr, wIndex: 0, wLength: 0},
            payload_len: 64},
    Packet'{h2d: 0, pid: PID::ACK, payload: '0, payload_len: 0},

    // Data stage (none)

    // Status stage
    Packet'{h2d: 1, pid: PID::IN, // Data stage が無い場合は IN
            payload: PP_Setup'{addr: 0, endp: 0, resv: 0},
            payload_len: 11},
    Packet'{h2d: 0, pid: PID::DATA1, payload: '0, payload_len: 0},
    Packet'{h2d: 1, pid: PID::ACK, payload: '0, payload_len: 0},

    // Setup stage
    Packet'{h2d: 1, pid: PID::SETUP,
            payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
            payload_len: 11},
    Packet'{h2d: 1, pid: PID::DATA0,
            payload: PP_SetupData'{bmRequestType: 8'b10000000,
                                   bRequest: GET_DESCRIPTOR,
                                   wValue: DescType::Device << 8 | 0,
                                   wIndex: 0,
                                   wLength: 16'd18},
            payload_len: 64},
    Packet'{h2d: 0, pid: PID::ACK, payload: '0, payload_len: 0},
  };
  let packets_len : u8 = NUM_INITIAL_PACKET;
  var packet_index : u8;
  var next_packet_index : u8;
  var packet_cache : Packet;

  // 各トランザクションの先頭のパケット番号
  let transaction : u8[4] = '{0, 3, 6, 255};
  var transaction_index : u8;

  enum PacketState: bit<4> {
    Idle, // 0
    Ready,
    Sync,
    PID,
    Data,
    CRC5,
    CRC16,
    EOP,
    RecvSync, // 8
    RecvPID,
    RecvData,
    RecvEOP,
    Reserved12,
    Reserved13,
    Reserved14,
    Error, // 15
  }
  var packet_state : PacketState;
  var bit_cnt : u8;

  var crc5 : bit<5>;
  var crc16 : bit<16>;
  var use_crc5 : bit; // 1=CRC5 0=CRC16
  var sync_buf : bit<8>;
  var pid_buf : bit<4>;

  always_ff (clk, rst_n) {
    if_reset {
      packet_index = 0;
      next_packet_index = 0;
      transaction_index = 0;
      packet_state = PacketState::Idle;
      dir_out = 0;
      sig_out = J;
    } else {
      case packet_state {
        PacketState::Idle: {
          if dev_en && packet_index <: packets_len {
            packet_state = PacketState::Ready;
            bit_cnt = 0;
            crc5 = '1;
            crc16 = '1;
          } else if ~dev_en {
            packet_index = 0;
            transaction_index = 0;
          }
        }
        PacketState::Ready: {
          if packets_to_send[packet_index].h2d {
            packet_state = PacketState::Sync;
            dir_out = 1;

            // packets_to_send[packet_index] をそのまま使うとクリティカルパスが
            // 長くなりすぎるので、キャッシュしてそれを使う。
            packet_cache = packets_to_send[packet_index];
          } else {
            packet_state = PacketState::RecvSync;
            dir_out = 0;
            packet_cache = '0;
          }

          next_packet_index = packet_index + 1;
          if packet_index >= transaction[transaction_index + 1] {
            transaction_index += 1;
          }
        }
        PacketState::Sync: {
          use_crc5 = (packet_cache.pid & 4'b0011) != 4'b0011;
          if ls_tick {
            if bit_cnt <: 7 {
              bit_cnt += 1;
              sig_out = L0;
            } else {
              packet_state = PacketState::PID;
              bit_cnt = 0;
              sig_out = L1;
            }
          }
        }
        PacketState::PID:
          if ls_tick {
            if bit_cnt <: 4 {
              sig_out = if packet_cache.pid[bit_cnt] ? L1 : L0;
              bit_cnt += 1;
            } else if bit_cnt <: 8 {
              sig_out = if packet_cache.pid[bit_cnt - 4] ? L0 : L1;
              if bit_cnt == 7 {
                if packet_cache.payload_len == 0 {
                  packet_state = PacketState::EOP;
                } else {
                  packet_state = PacketState::Data;
                }
                bit_cnt = 0;
              } else {
                bit_cnt += 1;
              }
            }
          }
        PacketState::Data:
          if ls_tick {
            var next_bit : bit;
            next_bit = packet_cache.payload[bit_cnt];
            sig_out = if next_bit ? L1 : L0;

            // x^5 + x^2 + x^0
            let fb5 : bit = next_bit ^ crc5[0];
            crc5[0] = crc5[1];
            crc5[1] = crc5[2];
            crc5[2] = crc5[3] ^ fb5;
            crc5[3] = crc5[4];
            crc5[4] = fb5;

            // x^16 + x^15 + x^2 + x^0
            let fb16 : bit = next_bit ^ crc16[0];
            crc16[0]  = crc16[1] ^ fb16;
            crc16[1]  = crc16[2];
            crc16[2]  = crc16[3];
            crc16[3]  = crc16[4];
            crc16[4]  = crc16[5];
            crc16[5]  = crc16[6];
            crc16[6]  = crc16[7];
            crc16[7]  = crc16[8];
            crc16[8]  = crc16[9];
            crc16[9]  = crc16[10];
            crc16[10] = crc16[11];
            crc16[11] = crc16[12];
            crc16[12] = crc16[13];
            crc16[13] = crc16[14] ^ fb16;
            crc16[14] = crc16[15];
            crc16[15] = fb16;

            if bit_cnt == packet_cache.payload_len - 1 {
              packet_state = if use_crc5
                              ? PacketState::CRC5
                              : PacketState::CRC16;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::CRC5:
          if ls_tick {
            sig_out = if crc5[bit_cnt] ? L0 : L1;
            if bit_cnt == 5 - 1 {
              packet_state = PacketState::EOP;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::CRC16:
          if ls_tick {
            sig_out = if crc16[bit_cnt] ? L0 : L1;
            if bit_cnt == 16 - 1 {
              packet_state = PacketState::EOP;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::EOP:
          if ls_tick {
            case bit_cnt {
              0,1: {
                sig_out = SE0;
                bit_cnt += 1;
              }
              2: {
                sig_out = J;
                bit_cnt += 1;
              }
              3: {
                dir_out = 0;
                bit_cnt = 4;
              }
              default: {
                packet_state = PacketState::Idle;
                packet_index = next_packet_index;
              }
            }
          }
        PacketState::RecvSync:
          if valid_in {
            sync_buf[bit_cnt] = if sig_in == L0 ? 0 : 1;
            bit_cnt += 1;
          } else if bit_cnt == 8 {
            if sync_buf == 8'h80 {
              packet_state = PacketState::RecvPID;
              bit_cnt = 0;
            } else {
              packet_state = PacketState::Error;
            }
          }
        PacketState::RecvPID:
          if valid_in {
            if bit_cnt <: 4 {
              packet_cache.pid[bit_cnt] = if sig_in == L0 ? 0 : 1;
              bit_cnt += 1;
            } else {
              pid_buf[bit_cnt - 4] = if sig_in == L0 ? 0 : 1;
              bit_cnt += 1;
            }
          } else if bit_cnt == 8 {
            if packet_cache.pid != ~pid_buf {
              packet_state = PacketState::Error;
            } else {
              packet_state = PacketState::RecvData;
              bit_cnt = 0;
              if packet_cache.pid != packets_to_send[packet_index].pid {
                // トランザクションをやりなおす
                next_packet_index = transaction[transaction_index];
              } else {
                packet_cache.payload_len = case packet_cache.pid {
                  PID::ACK: 0,
                  default: 0,
                };
              }
            }
          }
        PacketState::RecvData:
          if valid_in {
            if sig_in == SE0 {
              packet_state = PacketState::RecvEOP;
              bit_cnt = 1;
            } else {
              packet_cache.pid[bit_cnt] = if sig_in == L0 ? 0 : 1;
              bit_cnt += 1;
            }
          }
        PacketState::RecvEOP:
          if valid_in {
            case bit_cnt {
              0,1: {
                if sig_in == SE0 {
                  bit_cnt += 1;
                } else {
                  packet_state = PacketState::Error;
                }
              }
              2: {
                if sig_in == J {
                  bit_cnt += 1;
                } else {
                  packet_state = PacketState::Error;
                }
              }
              default: {
                packet_state = PacketState::Idle;
                packet_index = next_packet_index;
              }
            }
          }
        PacketState::Error: {
        }
      }
    }
  }

  always_ff (clk, rst_n) {
    if_reset {
      valid_out = 0;
    } else if ls_tick {
      valid_out = dir_out;
    } else {
      valid_out = 0;
    }
  }

  var tick_toggle : logic;
  always_ff (clk, rst_n) {
    if_reset {
      tick_toggle = 0;
    } else if (ms_tick) {
      tick_toggle = ~tick_toggle;
    }
  }

  assign status_led = {~packet_state, ~dev_speed};
  assign dbg = {5'0, sig_in, packet_state, 1'0, valid_in, 2'0};
}

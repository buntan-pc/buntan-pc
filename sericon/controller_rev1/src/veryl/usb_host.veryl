module usb_host #(
  param CLOCK_HZ: u32 = 96_000_000,
) (
  usb_clk: input clock,
  usb_rst_n: input reset_async_low,
  status_led: output logic<6>,
  usb_dp_raw: inout 'usb_raw tri logic,
  usb_dm_raw: inout 'usb_raw tri logic,
  //dbg: output bit<16>,
  dbg: output bit<8>,
) {
  var usb_dp : logic;
  var usb_dm : logic;
  var usb_dir_out : bit;
  var usb_dp_out : logic;
  var usb_dm_out : logic;

  unsafe (cdc) {
    inst usb_sync: $std::synchronizer_basic #(
      WIDTH: 2,
      STAGES: 2,
    ) (
      i_clk: usb_clk,
      i_rst: usb_rst_n,
      i_d: {usb_dp_raw, usb_dm_raw},
      o_d: {usb_dp, usb_dm},
    );

    assign usb_dp_raw = if usb_dir_out ? usb_dp_out : 1'bz;
    assign usb_dm_raw = if usb_dir_out ? usb_dm_out : 1'bz;
  }

  enum DevSpeed: bit<2> {
    None,
    LS,
    FS,
  }
  var dev_speed : DevSpeed;

  enum AttachState: bit<2> {
    WaitDevice,   // デバイス接続待ち
    WaitDebounce, // デバイスが安定するまで 100ms 以上待機
    Reset,        // バスのリセット中（10ms～20ms）
    Enabled,      // バス有効
  }
  var attach_state : AttachState;

  const TICK_MAX: u32 = CLOCK_HZ / 1000;
  var tick_gen : bit<$clog2(TICK_MAX)>; // 1ms 周期を作り出すタイマ
  var tick : bit; // 1ms 周期で 1 クロック幅だけ 1 になるイネーブル信号

  always_ff (usb_clk, usb_rst_n) {
    if_reset {
      tick_gen = 0;
      tick = 0;
    } else if tick_gen == TICK_MAX - 1 {
      tick_gen = 0;
      tick = 1;
    } else {
      tick_gen += 1;
      tick = 0;
    }
  }

  var ms_tim : bit<10>; // 1ms 単位で時間を計るタイマ（0～1023）

  always_ff (usb_clk, usb_rst_n) {
    if_reset {
      dev_speed = DevSpeed::None;
      attach_state = AttachState::WaitDevice;
      ms_tim = 0;
    } else {
      case attach_state {
        AttachState::WaitDevice:
          switch {
            ms_tim == 0:
              if usb_dp | usb_dm {
                ms_tim = 1;
              }
            /*1 <= ms_tim & */ms_tim <= 2:
              if tick {
                ms_tim += 1;
              }
            default: {
              dev_speed = if usb_dp ? DevSpeed::FS : DevSpeed::LS;
              attach_state = AttachState::WaitDebounce;
            }
          }
        AttachState::WaitDebounce:
          if tick {
            if ms_tim == 100-1 {
              attach_state = AttachState::Reset;
              ms_tim = 0;
            } else {
              ms_tim += 1;
            }
          }
        AttachState::Reset:
          if tick {
            if ms_tim == 10-1 {
              attach_state = AttachState::Enabled;
              ms_tim = 0;
            } else {
              ms_tim += 1;
            }
          }
        AttachState::Enabled:
          if tick & ms_tim <: 2 {
            ms_tim += 1;
          } else if ms_tim >= 2 {
            if ~usb_dir_out & ~usb_dp & ~usb_dm {
              attach_state = AttachState::WaitDevice;
            }
          }
      }
    }
  }

  always_comb {
    case attach_state {
      AttachState::WaitDevice: {
        usb_dir_out = 0;
        usb_dp_out  = 0;
        usb_dm_out  = 0;
      }
      AttachState::WaitDebounce: {
        usb_dir_out = 0;
        usb_dp_out  = 0;
        usb_dm_out  = 0;
      }
      AttachState::Reset: {
        usb_dir_out = 1;
        usb_dp_out  = 0;
        usb_dm_out  = 0;
      }
      default: {
        usb_dir_out = ms_tim == 0;
        usb_dp_out  = dev_speed == DevSpeed::FS;
        usb_dm_out  = dev_speed == DevSpeed::LS;
      }
    }
  }

  var tick_toggle : logic;
  always_ff (usb_clk, usb_rst_n) {
    if_reset {
      tick_toggle = 0;
    } else if (tick) {
      tick_toggle = ~tick_toggle;
    }
  }

  assign status_led = {if ~usb_rst_n ? 2'0 : 2'1, ~attach_state, ~dev_speed};
  //assign dbg = {ms_tim[7:0], attach_state, dev_speed, tick_toggle, 3'0};
  assign dbg = {attach_state, dev_speed, tick_toggle, 3'0};
}

import usb::*;
import usb::BusState::*;

module usb_host #(
  param CLOCK_HZ: u32 = 96_000_000,
) (
  clk: input clock,
  rst_n: input reset_async_low,
  status_led: output logic<6>,
  dp_raw: inout 'usb_raw tri logic,
  dm_raw: inout 'usb_raw tri logic,
  dbg: output bit<8>,
) {
  var dir_out : bit;

  const MS_TICK_PERIOD: u32 = CLOCK_HZ / 1000;
  var ms_tick_gen : bit<$clog2(MS_TICK_PERIOD)>; // 1ms 周期を作り出すタイマ
  var ms_tick : bit; // 1ms 周期で 1 クロック幅だけ 1 になるイネーブル信号

  always_ff (clk, rst_n) {
    if_reset {
      ms_tick_gen = 0;
      ms_tick = 0;
    } else if ms_tick_gen == MS_TICK_PERIOD - 1 {
      ms_tick_gen = 0;
      ms_tick = 1;
    } else {
      ms_tick_gen += 1;
      ms_tick = 0;
    }
  }

  var packet_send_req : bit;
  var nrzi_out : bit;

  enum DeviceRequest: bit<8> {
    SET_ADDRESS = 5,
  }
  var device_request : DeviceRequest;

  const LS_BIT_PERIOD : u32 = CLOCK_HZ/1_500_000;
  var ls_tick_gen : bit<$clog2(LS_BIT_PERIOD - 1)>; // LS のビットタイミング 1.5Mbps を作るタイマ
  var ls_tick : bit; // ビット先頭で 1 クロック期間だけ 1 になる

  always_ff (clk, rst_n) {
    if_reset {
      ls_tick_gen = 0;
      ls_tick = 0;
    } else if ls_tick_gen == LS_BIT_PERIOD - 1 {
      ls_tick_gen = 0;
      ls_tick = 1;
    } else {
      ls_tick_gen += 1;
      ls_tick = 0;
    }
  }

  var dev_speed : DevSpeed;
  var dev_en : bit;
  var sig_out : BusState;
  inst bus : usb_bus #(
    CLOCK_HZ,
  ) (
    clk,
    rst_n,
    bit_tick: ls_tick,
    ms_tick,
    dev_speed,
    dev_en,
    dp_raw,
    dm_raw,
    dir_h2d: dir_out,
    sig_h2d: sig_out,
  );

  enum PacketState: bit<_> {
    Idle,
    Sync,
    PID,
    Data,
    Handshake,
    EOP,
  }
  var packet_state : PacketState;
  var bit_cnt : u8;

  let pid_setup : bit<4> = 4'b1101;
  let devreq_value : u16 = 16'h001A;
  let crc5_value : bit<5> = 5'b00010;

  always_ff (clk, rst_n) {
    if_reset {
      packet_state = PacketState::Idle;
      dir_out = 0;
      sig_out = J;
    } else {
      case packet_state {
        PacketState::Idle: {
          if dev_en {
            packet_state = PacketState::Sync;
            dir_out = 1;
            sig_out = J;
            bit_cnt = 0;
          }
        }
        PacketState::Sync:
          if ls_tick {
            if bit_cnt <: 7 {
              bit_cnt += 1;
              sig_out = D0;
            } else {
              packet_state = PacketState::PID;
              bit_cnt = 0;
              sig_out = D1;
            }
          }
        PacketState::PID:
          if ls_tick {
            if bit_cnt <: 4 {
              sig_out = if pid_setup[bit_cnt] ? D1 : D0;
              bit_cnt += 1;
            } else if bit_cnt <: 8 {
              sig_out = if pid_setup[bit_cnt - 4] ? D0 : D1;
              if bit_cnt == 7 {
                packet_state = PacketState::Data;
                bit_cnt = 0;
              } else {
                bit_cnt += 1;
              }
            }
          }
        PacketState::Data:
          if ls_tick {
            case bit_cnt {
              0..7 /* ADR */: sig_out = D0;
              7..11 /* ENDP */: sig_out = D0;
              11..16 /* CRC5 */: sig_out = if crc5_value[bit_cnt - 11] ? D1 : D0;
              default: {
                dir_out = 0;
              }
            }
            //case bit_cnt {
            //  0..8 /* bmRequestType */: case device_request {
            //    DeviceRequest::SET_ADDRESS: nrzi_out = ~nrzi_out;
            //    default: nrzi_out = ~nrzi_out;
            //  }
            //  8..16 /* bRequest */    : if device_request[bit_cnt - 8] == 0 {
            //    nrzi_out = ~nrzi_out;
            //  }
            //  16..32 /* wValue */     : if devreq_value[bit_cnt - 16] == 0 {
            //    nrzi_out = ~nrzi_out;
            //  }
            //  32..48 /* wIndex */     : nrzi_out = ~nrzi_out;
            //  48..64 /* wLength */    : nrzi_out = ~nrzi_out;
            //  default: packet_state = PacketState::Idle;
            //}
            if bit_cnt <: 255 {
              bit_cnt += 1;
            }

            if ~dev_en {
              packet_state = PacketState::Idle;
            }
          }
      }
    }
  }

  var tick_toggle : logic;
  always_ff (clk, rst_n) {
    if_reset {
      tick_toggle = 0;
    } else if (ms_tick) {
      tick_toggle = ~tick_toggle;
    }
  }

  assign status_led = {~dev_en, ~packet_state, ~dev_speed};
  assign dbg = {dev_en, packet_state, tick_toggle, 3'0};
}

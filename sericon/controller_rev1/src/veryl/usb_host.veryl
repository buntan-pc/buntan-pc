import usb::*;
import usb::BusState::*;

module usb_host #(
  param CLOCK_HZ: u32 = 48_000_000,
) (
  clk: input clock,
  rst_n: input reset_async_low,
  status_led: output logic<6>,
  dp_raw: inout 'usb_raw tri logic,
  dm_raw: inout 'usb_raw tri logic,
  dbg: output bit<16>,
) {
  var dir_out : bit;

  const MS_TICK_PERIOD: u32 = CLOCK_HZ / 1000;
  var ms_tick_gen : bit<$clog2(MS_TICK_PERIOD)>; // 1ms 周期を作り出すタイマ
  var ms_tick : bit; // 1ms 周期で 1 クロック幅だけ 1 になるイネーブル信号

  always_ff (clk, rst_n) {
    if_reset {
      ms_tick_gen = 0;
      ms_tick = 0;
    } else if ms_tick_gen == MS_TICK_PERIOD - 1 {
      ms_tick_gen = 0;
      ms_tick = 1;
    } else {
      ms_tick_gen += 1;
      ms_tick = 0;
    }
  }

  var packet_send_req : bit;
  var nrzi_out : bit;

  const LS_BIT_PERIOD : u32 = CLOCK_HZ/1_500_000;
  var ls_tick_gen : bit<$clog2(LS_BIT_PERIOD - 1)>; // LS のビットタイミング 1.5Mbps を作るタイマ
  var ls_tick : bit; // ビット先頭で 1 クロック期間だけ 1 になる

  always_ff (clk, rst_n) {
    if_reset {
      ls_tick_gen = 0;
      ls_tick = 0;
    } else if ls_tick_gen == LS_BIT_PERIOD - 1 {
      ls_tick_gen = 0;
      ls_tick = 1;
    } else {
      ls_tick_gen += 1;
      ls_tick = 0;
    }
  }

  var dev_speed : DevSpeed;
  var dev_en : bit;
  var sig_out : BusState;
  var valid_out : bit;
  var sig_in : BusState;
  var valid_in : bit;
  inst bus : usb_bus #(
    CLOCK_HZ,
  ) (
    clk,
    rst_n,
    ms_tick,
    dev_speed,
    dev_en,
    dp_raw,
    dm_raw,
    dir_h2d: dir_out,
    sig_h2d: sig_out,
    valid_h2d: valid_out,
    sig_d2h: sig_in,
    valid_d2h: valid_in,
  );

  // PP: PacketPayload
  struct PP_Setup {
    resv: bit<53>,
    endp: bit<4>,
    addr: bit<7>,
  }
  struct PP_SetupData {
    wLength: u16,
    wIndex: u16,
    wValue: u16,
    bRequest: u8,
    bmRequestType: u8,
  }
  struct Packet {
    pid: PID,
    payload: bit<64>,
    payload_ext: bit, // ペイロードを外部に書くなら 1。その場合、payload には DescType を書く
    payload_len: bit<3+8>,
  }

  enum CommandKind {
    SendPacket,
    RecvPacket,
    Other,
  }
  enum CID: bit<4> { // Command ID
    Delay,
    SearchBootInterface,
  }
  struct Command {
    kind: CommandKind,
    data: Packet,
  }

  var desc_device : bit<8*18>;
  // バイト配列にすることで BRAM 化できるようにする。
  // フラットな bit ベクタのまま可変位置でビット選択すると、合成時に巨大なマルチプレクサになり
  // 大量の LUT を消費してしまう。
  var desc_config : bit<8>[128];
  var config_total_len : u16; // bytes
  var config_value : u8; // bConfigurationValue

  var desc_byte_index : u8;
  var boot_interface_number : u8;

  var recv_byte_buf : bit<8>; // desc_config へバイト単位で書き込むためのバッファ
  var desc_rd_addr : u8;
  var desc_rd_data : bit<8>; // desc_config の読み出し結果
  var sbi_phase : bit<4>; // SearchBootInterface のサブステート
  var sbi_match : bit;

  const NUM_INITIAL_COMMAND : u8 = 47;
  let dev_addr: bit<7> = 6;
  let commands : Command[NUM_INITIAL_COMMAND] = '{
    // Setup stage
    Command'{ // 0
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::SETUP,
                    payload: PP_Setup'{addr: 0, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 1
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::DATA0,
                    payload: PP_SetupData'{bmRequestType: 0,
                                           bRequest: SET_ADDRESS,
                                           wValue: dev_addr,
                                           wIndex: 0, wLength: 0},
                    payload_ext: 0, payload_len: 64},
    },
    Command'{ // 2
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Data stage (none)

    // Status stage
    Command'{ // 3
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::IN, // Data stage が無い場合は IN
                    payload: PP_Setup'{addr: 0, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 4
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::DATA1, payload: '0, payload_ext: 0, payload_len: 0},
    },
    Command'{ // 5
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Delay >= 2ms
    Command'{ // 6
      kind: CommandKind::Other,
      data: Packet'{pid: CID::Delay as PID, payload: 2, payload_ext: 0, payload_len: 8},
    },

    // Setup stage
    Command'{ // 7
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::SETUP,
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 8
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::DATA0,
                    payload: PP_SetupData'{bmRequestType: 8'b10000000,
                                           bRequest: GET_DESCRIPTOR,
                                           wValue: DescType::Device << 8 | 0,
                                           wIndex: 0,
                                           wLength: 16'd18},
                    payload_ext: 0, payload_len: 64},
    },
    Command'{ // 9
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Data stage
    Command'{ // 10
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::IN,
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 11
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::DATA1, payload: DescType::Device, payload_ext: 1, payload_len: 8*18},
    },
    Command'{ // 12
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Status stage
    Command'{ // 13
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::OUT, // 直前が IN 転送なのでステータスは OUT
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 14
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::DATA1, payload: '0, payload_ext: 0, payload_len: 0},
    },
    Command'{ // 15
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Setup stage
    Command'{ // 16
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::SETUP,
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 17
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::DATA0,
                    payload: PP_SetupData'{bmRequestType: 8'b10000000,
                                           bRequest: GET_DESCRIPTOR,
                                           wValue: DescType::Configuration << 8 | 0,
                                           wIndex: 0,
                                           wLength: 16'd9},
                    payload_ext: 0, payload_len: 64},
    },
    Command'{ // 18
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Data stage
    Command'{ // 19
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::IN,
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 20
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::DATA1, payload: DescType::Configuration, payload_ext: 1, payload_len: 8*9},
    },
    Command'{ // 21
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Status stage
    Command'{ // 22
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::OUT, // 直前が IN 転送なのでステータスは OUT
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 23
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::DATA1, payload: '0, payload_ext: 0, payload_len: 0},
    },
    Command'{ // 24
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Setup stage
    Command'{ // 25
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::SETUP,
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 26
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::DATA0,
                    payload: PP_SetupData'{bmRequestType: 8'b10000000,
                                           bRequest: GET_DESCRIPTOR,
                                           wValue: DescType::Configuration << 8 | 0,
                                           wIndex: 0,
                                           wLength: config_total_len},
                    payload_ext: 0, payload_len: 64},
    },
    Command'{ // 27
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Data stage
    Command'{ // 28
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::IN,
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 29
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::DATA1, payload: DescType::Configuration,
                    payload_ext: 1, payload_len: 8*config_total_len},
    },
    Command'{ // 30
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Status stage
    Command'{ // 31
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::OUT, // 直前が IN 転送なのでステータスは OUT
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 32
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::DATA1, payload: '0, payload_ext: 0, payload_len: 0},
    },
    Command'{ // 33
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Setup stage
    Command'{ // 34
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::SETUP,
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 35
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::DATA0,
                    payload: PP_SetupData'{bmRequestType: 0,
                                           bRequest: SET_CONFIGURATION,
                                           wValue: config_value /* bConfigurationValue */,
                                           wIndex: 0, wLength: 0},
                    payload_ext: 0, payload_len: 64},
    },
    Command'{ // 36
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Data stage (none)

    // Status stage
    Command'{ // 37
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::IN, // Data stage が無い場合は IN
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 38
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::DATA1, payload: '0, payload_ext: 0, payload_len: 0},
    },
    Command'{ // 39
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    Command'{ // 40
      kind: CommandKind::Other,
      data: Packet'{pid: CID::SearchBootInterface as PID, payload: 1, payload_ext: 0, payload_len: 0},
    },

    // Setup stage
    Command'{ // 41
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::SETUP,
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 42
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::DATA0,
                    payload: PP_SetupData'{bmRequestType: 8'b00100001,
                                           bRequest: SET_PROTOCOL,
                                           wValue: 0, // Boot Protocol
                                           wIndex: boot_interface_number,
                                           wLength: 0},
                    payload_ext: 0, payload_len: 64},
    },
    Command'{ // 43
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },

    // Data stage (none)

    // Status stage
    Command'{ // 44
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::IN, // Data stage が無い場合は IN
                    payload: PP_Setup'{addr: dev_addr, endp: 0, resv: 0},
                    payload_ext: 0, payload_len: 11},
    },
    Command'{ // 45
      kind: CommandKind::RecvPacket,
      data: Packet'{pid: PID::DATA1, payload: '0, payload_ext: 0, payload_len: 0},
    },
    Command'{ // 46
      kind: CommandKind::SendPacket,
      data: Packet'{pid: PID::ACK, payload: '0, payload_ext: 0, payload_len: 0},
    },
  };
  let commands_len : u8 = NUM_INITIAL_COMMAND;
  var command_index : u8;
  var next_command_index : u8;
  var command_cache : Command;
  var recv_packet : Packet;

  // 各トランザクションの先頭のコマンド番号
  let transaction : u8[17] = '{0, 3, 6, 7, 10, 13, 16, 19, 22, 25, 28, 31, 34, 37, 41, 44, 255};
  var transaction_index : u8;

  enum CommandState {
    Ready,
    Exec,
    Next,
  }

  enum PacketState: bit<3> {
    Ready, // 0
    Sync,
    PID,
    Data,
    CRC5,
    CRC16,
    EOP,
    Error, // 7
  }

  var command_state : CommandState;
  var packet_state : PacketState;
  var bit_cnt : u8;

  var crc5 : bit<5>;
  var crc16 : bit<16>;
  var use_crc5 : bit; // 1=CRC5 0=CRC16
  var sync_buf : bit<8>;
  var pid_buf : bit<4>;

  var data01 : bit;
  var repeat_data : bit;
  var recv_payload_pos : u16;

  always_ff (clk, rst_n) {
    if_reset {
      command_index = 0;
      next_command_index = 0;
      transaction_index = 0;
      command_state = CommandState::Ready;
      command_cache = '0;
    } else {
      case command_state {
        CommandState::Ready: {
          // commands[command_index] をそのまま使うとクリティカルパスが
          // 長くなりすぎるので、キャッシュしてそれを使う。
          command_cache = commands[command_index];

          let next_i : u8 = command_index + 1;
          if next_i == transaction[transaction_index + 1] && repeat_data {
            // トランザクションを繰り返す
            next_command_index = transaction[transaction_index];
          } else {
            next_command_index = next_i;
          }

          if command_index >= transaction[transaction_index + 1] {
            transaction_index += 1;
          }

          if dev_en && command_index <: commands_len {
            command_state = CommandState::Exec;
          } else if ~dev_en {
            command_index = 0;
            transaction_index = 0;
          }
        }
        CommandState::Exec: {
          case command_cache.kind {
            CommandKind::SendPacket: {
              if packet_state == PacketState::EOP && bit_cnt >= 4 {
                command_state = CommandState::Next;
              }
            }
            CommandKind::RecvPacket: {
              if packet_state == PacketState::EOP && bit_cnt >= 4 {
                let expect_data_packet : bit
                  = command_cache.data.pid[2:0] == PID::DATA0[2:0];
                if (expect_data_packet && recv_packet.pid != {data01, PID::DATA0[2:0]}) ||
                   (~expect_data_packet && recv_packet.pid != command_cache.data.pid) {
                  // トランザクションをやりなおす
                  next_command_index = transaction[transaction_index];
                }
                command_state = CommandState::Next;
              }
            }
            CommandKind::Other: {
              if bit_cnt >= command_cache.data.payload[7:0] {
                command_state = CommandState::Next;
              }
            }
          }
        }
        CommandState::Next: {
          command_state = CommandState::Ready;
          command_index = next_command_index;
        }
      }
    }
  }

  always_ff (clk, rst_n) {
    if_reset {
      packet_state = PacketState::Ready;
      dir_out = 0;
      sig_out = J;
      bit_cnt = 0;
      crc5 = '1;
      crc16 = '1;
      pid_buf = '0;
      data01 = 0;
      repeat_data = 0;
      recv_payload_pos = 0;
      config_total_len = 0;
      config_value = 0;

      desc_byte_index = 0;
      boot_interface_number = 0;

      recv_byte_buf = 0;
      desc_rd_addr = 0;
      desc_rd_data = 0;
      sbi_phase = 0;
      sbi_match = 0;
    } else if command_state == CommandState::Ready {
      packet_state = PacketState::Ready;
      bit_cnt = 0;
      crc5 = '1;
      crc16 = '1;
    } else if command_state == CommandState::Next {
    } else if command_cache.kind == CommandKind::Other {
      case command_cache.data.pid {
        CID::Delay: {
          if ms_tick {
            bit_cnt += 1;
          }
        }
        CID::SearchBootInterface: {
          // desc_config は BRAM 化してあるため、1 サイクルにつき 1 バイトだけ読み出す。
          // 読み出しアドレスをセットしてから、結果が desc_rd_data に出るまで1サイクルかかる。
          case sbi_phase {
            0: { // bDescriptorType (offset+1) を要求
              desc_rd_addr = desc_byte_index + 1;
              sbi_match = 1;
              sbi_phase = 1;
            }
            1: { // 読み出し待ち
              desc_rd_data = desc_config[desc_rd_addr];
              sbi_phase = 2;
            }
            2: { // bDescriptorType を判定し、bInterfaceClass (offset+5) を要求
              sbi_match &= desc_rd_data == DescType::Interface;
              desc_rd_addr = desc_byte_index + 5;
              sbi_phase = 3;
            }
            3: {
              desc_rd_data = desc_config[desc_rd_addr];
              sbi_phase = 4;
            }
            4: { // bInterfaceClass (HID) を判定し、bInterfaceSubClass (offset+6) を要求
              sbi_match &= desc_rd_data == 3;
              desc_rd_addr = desc_byte_index + 6;
              sbi_phase = 5;
            }
            5: {
              desc_rd_data = desc_config[desc_rd_addr];
              sbi_phase = 6;
            }
            6: { // bInterfaceSubClass (Boot Interface) を判定し、bInterfaceProtocol (offset+7) を要求
              sbi_match &= desc_rd_data == 1;
              desc_rd_addr = desc_byte_index + 7;
              sbi_phase = 7;
            }
            7: {
              desc_rd_data = desc_config[desc_rd_addr];
              sbi_phase = 8;
            }
            8: { // bInterfaceProtocol (Keyboard) を判定する。
                 // 一致していれば bInterfaceNumber (offset+2)、不一致なら bLength (offset+0) を要求する
              sbi_match &= desc_rd_data == 1;
              desc_rd_addr = if sbi_match ? desc_byte_index + 2 : desc_byte_index;
              sbi_phase = 9;
            }
            9: {
              desc_rd_data = desc_config[desc_rd_addr];
              sbi_phase = 10;
            }
            10: {
              if sbi_match {
                boot_interface_number = desc_rd_data;
                bit_cnt = 1; // bit_cnt >= payload にするとコマンド終了
              } else {
                desc_byte_index += desc_rd_data; // bLength だけ進めて次のディスクリプタへ
              }
              sbi_phase = 0;
            }
            default: {
              sbi_phase = 0;
            }
          }
        }
        default: {
        }
      }
    } else if command_cache.kind == CommandKind::SendPacket {
      case packet_state {
        PacketState::Ready: {
          packet_state = PacketState::Sync;
          dir_out = 1;

          if command_cache.data.pid[2:0] == PID::DATA0[2:0] {
            if repeat_data {
              data01 = ~data01;
              repeat_data = 0;
            } else {
              data01 = command_cache.data.pid[3];
            }
          } else if command_cache.data.pid == PID::SETUP {
            recv_payload_pos = 0;
          }

          pid_buf = command_cache.data.pid;
        }
        PacketState::Sync: {
          use_crc5 = pid_buf[1:0] != 2'b11;
          if pid_buf[2:0] == PID::DATA0[2:0] {
            pid_buf[3] = data01;
          }
          if ls_tick {
            if bit_cnt <: 7 {
              bit_cnt += 1;
              sig_out = L0;
            } else {
              packet_state = PacketState::PID;
              bit_cnt = 0;
              sig_out = L1;
            }
          }
        }
        PacketState::PID:
          if ls_tick {
            if bit_cnt <: 4 {
              sig_out = if pid_buf[bit_cnt] ? L1 : L0;
              bit_cnt += 1;
            } else if bit_cnt <: 8 {
              sig_out = if pid_buf[bit_cnt - 4] ? L0 : L1;
              if bit_cnt == 7 {
                if command_cache.data.payload_len == 0 {
                  packet_state = if use_crc5
                                  ? PacketState::CRC5
                                  : PacketState::CRC16;
                } else {
                  packet_state = PacketState::Data;
                }
                bit_cnt = 0;
              } else {
                bit_cnt += 1;
              }
            }
          }
        PacketState::Data:
          if ls_tick {
            var next_bit : bit;
            next_bit = command_cache.data.payload[bit_cnt];
            sig_out = if next_bit ? L1 : L0;

            // x^5 + x^2 + x^0
            let fb5 : bit = next_bit ^ crc5[0];
            crc5[0] = crc5[1];
            crc5[1] = crc5[2];
            crc5[2] = crc5[3] ^ fb5;
            crc5[3] = crc5[4];
            crc5[4] = fb5;

            // x^16 + x^15 + x^2 + x^0
            let fb16 : bit = next_bit ^ crc16[0];
            crc16[0]  = crc16[1] ^ fb16;
            crc16[1]  = crc16[2];
            crc16[2]  = crc16[3];
            crc16[3]  = crc16[4];
            crc16[4]  = crc16[5];
            crc16[5]  = crc16[6];
            crc16[6]  = crc16[7];
            crc16[7]  = crc16[8];
            crc16[8]  = crc16[9];
            crc16[9]  = crc16[10];
            crc16[10] = crc16[11];
            crc16[11] = crc16[12];
            crc16[12] = crc16[13];
            crc16[13] = crc16[14] ^ fb16;
            crc16[14] = crc16[15];
            crc16[15] = fb16;

            if bit_cnt == command_cache.data.payload_len - 1 {
              packet_state = if use_crc5
                              ? PacketState::CRC5
                              : PacketState::CRC16;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::CRC5:
          if ls_tick {
            sig_out = if crc5[bit_cnt] ? L0 : L1;
            if bit_cnt == 5 - 1 {
              packet_state = PacketState::EOP;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::CRC16:
          if ls_tick {
            sig_out = if crc16[bit_cnt] ? L0 : L1;
            if bit_cnt == 16 - 1 {
              packet_state = PacketState::EOP;
              bit_cnt = 0;
            } else {
              bit_cnt += 1;
            }
          }
        PacketState::EOP:
          if ls_tick {
            case bit_cnt {
              0,1: {
                sig_out = SE0;
                bit_cnt += 1;
              }
              2: {
                sig_out = J;
                bit_cnt += 1;
              }
              default: {
                dir_out = 0;
                bit_cnt = 4;
              }
            }
          }
        }
    } else { // RecvPacket
      case packet_state {
        PacketState::Ready: {
          packet_state = PacketState::Sync;
          dir_out = 0;

        }
        PacketState::Sync:
          if valid_in {
            sync_buf[bit_cnt] = if sig_in == L0 ? 0 : 1;
            bit_cnt += 1;
          } else if bit_cnt == 8 {
            if sync_buf == 8'h80 {
              packet_state = PacketState::PID;
              bit_cnt = 0;
            } else {
              packet_state = PacketState::Error;
            }
          }
        PacketState::PID:
          if valid_in {
            if bit_cnt <: 4 {
              recv_packet.pid[bit_cnt] = if sig_in == L0 ? 0 : 1;
              bit_cnt += 1;
            } else {
              pid_buf[bit_cnt - 4] = if sig_in == L0 ? 0 : 1;
              bit_cnt += 1;
            }
          } else if bit_cnt == 8 {
            if recv_packet.pid != ~pid_buf {
              packet_state = PacketState::Error;
            } else {
              packet_state = PacketState::Data;
              bit_cnt = 0;
            }

            if recv_packet.pid[2:0] == PID::DATA0[2:0] {
              if repeat_data {
                data01 = ~data01;
                repeat_data = 0;
              } else {
                data01 = recv_packet.pid[3];
              }
            }
          }
        PacketState::Data:
          if valid_in {
            if sig_in == SE0 {
              packet_state = PacketState::EOP;
              bit_cnt = 1;
            } else {
              if command_cache.data.payload_ext {
                if recv_payload_pos <: command_cache.data.payload_len {
                  case command_cache.data.payload {
                    DescType::Device:
                      desc_device[recv_payload_pos] = if sig_in == L0 ? 0 : 1;
                    default: { // DescType::Configuration
                      let recv_bit : bit = if sig_in == L0 ? 0 : 1;
                      if recv_payload_pos[2:0] == 3'b111 {
                        // 1バイト分そろったので desc_config (BRAM) に書き込む。
                        // recv_byte_buf に前の7ビット分が入っているので、今回のビットと合わせて1バイトにする。
                        let byte_val : bit<8> = {recv_bit, recv_byte_buf[6:0]};
                        let byte_index : u8 = recv_payload_pos[10:3];
                        desc_config[byte_index] = byte_val;
                        case byte_index {
                          8'd2: config_total_len[7:0] = byte_val;  // wTotalLength 下位バイト
                          8'd3: config_total_len[15:8] = byte_val; // wTotalLength 上位バイト
                          8'd5: config_value = byte_val;           // bConfigurationValue
                          default: {}
                        }
                      }
                      recv_byte_buf[recv_payload_pos[2:0]] = recv_bit;
                    }
                  }
                }
              } else {
                recv_packet.payload[recv_payload_pos] = if sig_in == L0 ? 0 : 1;
              }
              recv_payload_pos += 1;
            }
          }
        PacketState::EOP:
          if valid_in {
            case bit_cnt {
              0,1: {
                if sig_in == SE0 {
                  bit_cnt += 1;
                } else {
                  packet_state = PacketState::Error;
                }
              }
              2,3: {
                if sig_in == J {
                  bit_cnt += 1;
                } else {
                  packet_state = PacketState::Error;
                }
              }
              default: {
                bit_cnt = 4;
                if recv_packet.pid[2:0] == PID::DATA0[2:0] {
                  // CRC16 の分を減らして考える
                  let new_pos : u16 = recv_payload_pos - 16;
                  if new_pos >= command_cache.data.payload_len {
                    recv_payload_pos = 0;
                  } else {
                    recv_payload_pos = new_pos;
                    repeat_data = 1;
                  }
                }
              }
            }
          }
        PacketState::Error: {
        }
      }
    }
  }

  always_ff (clk, rst_n) {
    if_reset {
      valid_out = 0;
    } else if ls_tick {
      valid_out = dir_out;
    } else {
      valid_out = 0;
    }
  }

  var tick_toggle : logic;
  always_ff (clk, rst_n) {
    if_reset {
      tick_toggle = 0;
    } else if (ms_tick) {
      tick_toggle = ~tick_toggle;
    }
  }

  assign status_led = {~packet_state, ~dev_speed};
  assign dbg = {config_total_len[6:0], repeat_data, packet_state, command_state, valid_in, 2'0};
}

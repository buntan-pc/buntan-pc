import usb::*;
import usb::BusState::*;

module usb_host #(
  param CLOCK_HZ: u32 = 96_000_000,
) (
  usb_clk: input clock,
  usb_rst_n: input reset_async_low,
  status_led: output logic<6>,
  usb_dp_raw: inout 'usb_raw tri logic,
  usb_dm_raw: inout 'usb_raw tri logic,
  dbg: output bit<8>,
) {
  var usb_dir_out : bit;

  var dev_speed : DevSpeed;

  enum AttachState: bit<3> {
    WaitDevice,   // デバイス接続待ち
    WaitDebounce, // デバイスが安定するまで 100ms 以上待機
    BusReset,     // バスのリセット中（10ms～20ms）
    Default,      // デフォルト状態
    Addressed,    // アドレス設定済み
    Configured,   // 構成設定済み
  }

  const TICK_MAX: u32 = CLOCK_HZ / 1000;
  var tick_gen : bit<$clog2(TICK_MAX)>; // 1ms 周期を作り出すタイマ
  var tick : bit; // 1ms 周期で 1 クロック幅だけ 1 になるイネーブル信号

  always_ff (usb_clk, usb_rst_n) {
    if_reset {
      tick_gen = 0;
      tick = 0;
    } else if tick_gen == TICK_MAX - 1 {
      tick_gen = 0;
      tick = 1;
    } else {
      tick_gen += 1;
      tick = 0;
    }
  }

  var ms_tim : bit<10>; // 1ms 単位で時間を計るタイマ（0～1023）

  var packet_send_req : bit;
  var nrzi_out : bit;

  enum DeviceRequest: bit<8> {
    SET_ADDRESS = 5,
  }
  var device_request : DeviceRequest;

  const LS_BIT_PERIOD : u32 = CLOCK_HZ/1_500_000;
  var ls_tick_gen : bit<$clog2(LS_BIT_PERIOD - 1)>; // LS のビットタイミング 1.5Mbps を作るタイマ
  var ls_tick : bit; // ビット先頭で 1 クロック期間だけ 1 になる

  always_ff (usb_clk, usb_rst_n) {
    if_reset {
      ls_tick_gen = 0;
      ls_tick = 0;
    } else if ls_tick_gen == LS_BIT_PERIOD - 1 {
      ls_tick_gen = 0;
      ls_tick = 1;
    } else {
      ls_tick_gen += 1;
      ls_tick = 0;
    }
  }

  var usb_sig_out : BusState;
  inst usb_bus_0 : usb_bus #(
    CLOCK_HZ,
  ) (
    clk: usb_clk,
    rst_n: usb_rst_n,
    bit_tick: ls_tick,
    ms_tick: tick,
    dev_speed: dev_speed,
    dp_raw: usb_dp_raw,
    dm_raw: usb_dm_raw,
    dir_h2d: usb_dir_out,
    sig_h2d: usb_sig_out,
  );

  enum PacketState: bit<_> {
    Idle,
    Sync,
    PID,
    Data,
    Handshake,
    EOP,
  }
  var packet_state : PacketState;
  var bit_cnt : u8;

  let pid_setup : bit<4> = 4'b1101;
  let devreq_value : u16 = 16'h001A;
  let crc5_value : bit<5> = 5'b00010;

  always_ff (usb_clk, usb_rst_n) {
    if_reset {
      packet_state = PacketState::Idle;
      usb_dir_out = 0;
      usb_sig_out = J;
    } else {
      case packet_state {
        PacketState::Idle: {
          if dev_speed != DevSpeed::NoDevice {
            packet_state = PacketState::Sync;
            usb_dir_out = 1;
            usb_sig_out = J;
            bit_cnt = 0;
          }
        }
        PacketState::Sync:
          if ls_tick {
            if bit_cnt <: 7 {
              bit_cnt += 1;
              usb_sig_out = D0;
            } else {
              packet_state = PacketState::PID;
              bit_cnt = 0;
              usb_sig_out = D1;
            }
          }
        PacketState::PID:
          if ls_tick {
            if bit_cnt <: 4 {
              usb_sig_out = if pid_setup[bit_cnt] ? D1 : D0;
              bit_cnt += 1;
            } else if bit_cnt <: 8 {
              usb_sig_out = if pid_setup[bit_cnt - 4] ? D0 : D1;
              if bit_cnt == 7 {
                packet_state = PacketState::Data;
                bit_cnt = 0;
              } else {
                bit_cnt += 1;
              }
            }
          }
        PacketState::Data:
          if ls_tick {
            case bit_cnt {
              0..7 /* ADR */: usb_sig_out = D0;
              7..11 /* ENDP */: usb_sig_out = D0;
              11..16 /* CRC5 */: usb_sig_out = if crc5_value[bit_cnt - 11] ? D1 : D0;
              default: {
                usb_dir_out = 0;
              }
            }
            //case bit_cnt {
            //  0..8 /* bmRequestType */: case device_request {
            //    DeviceRequest::SET_ADDRESS: nrzi_out = ~nrzi_out;
            //    default: nrzi_out = ~nrzi_out;
            //  }
            //  8..16 /* bRequest */    : if device_request[bit_cnt - 8] == 0 {
            //    nrzi_out = ~nrzi_out;
            //  }
            //  16..32 /* wValue */     : if devreq_value[bit_cnt - 16] == 0 {
            //    nrzi_out = ~nrzi_out;
            //  }
            //  32..48 /* wIndex */     : nrzi_out = ~nrzi_out;
            //  48..64 /* wLength */    : nrzi_out = ~nrzi_out;
            //  default: packet_state = PacketState::Idle;
            //}
            bit_cnt += 1;
          }
      }
    }
  }

  var tick_toggle : logic;
  always_ff (usb_clk, usb_rst_n) {
    if_reset {
      tick_toggle = 0;
    } else if (tick) {
      tick_toggle = ~tick_toggle;
    }
  }

  assign status_led = {if ~usb_rst_n ? 1'0 : 1'1, ~packet_state, ~dev_speed};
  assign dbg = {1'0, packet_state, tick_toggle, 3'0};
}

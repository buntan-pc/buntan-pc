import usb::*;
import usb::BusState::*;
import usb::DevSpeed::*;

module usb_bus #(
  param CLOCK_HZ: u32 = 48_000_000,
) (
  clk: input clock,
  rst_n: input reset_async_low,
  ms_tick: input bit, // 1ms 間隔の始まりを示す 1 サイクル幅のパルス
  bit_tick: input bit, // ビットの始まりを示す 1 サイクル幅のパルス
  dev_speed: output DevSpeed, // 検出したデバイス速度
  dev_en: output bit, // デバイスが接続されバスリセットが完了した状態
  dp_raw: inout 'usb_raw tri logic,
  dm_raw: inout 'usb_raw tri logic,
  dir_h2d: input bit, // 1 = output (host to device)
  sig_h2d: input BusState,
  sig_d2h: output BusState,
) {
  var dp_h2d : logic;
  var dm_h2d : logic;
  var dp_d2h : logic;
  var dm_d2h : logic;
  var force_h2d : bit;

  unsafe (cdc) {
    inst usb_sync: $std::synchronizer_basic #(
      WIDTH: 2,
      STAGES: 2,
    ) (
      i_clk: clk,
      i_rst: rst_n,
      i_d: {dp_raw, dm_raw},
      o_d: {dp_d2h, dm_d2h},
    );

    assign dp_raw = if (dir_h2d | force_h2d) ? dp_h2d : 1'bz;
    assign dm_raw = if (dir_h2d | force_h2d) ? dm_h2d : 1'bz;
  }

  //var sig_d2h_jk : BusState;
  always_comb {
    case {dp_d2h, dm_d2h} {
      0: {
        sig_d2h = SE0;
        //sig_d2h_jk = SE0;
      }
      1: {
        sig_d2h = D0;
        //sig_d2h_jk = if dev_speed == LS ? J : K;
      }
      2: {
        sig_d2h = D1;
        //sig_d2h_jk = if dev_speed == FS ? J : K;
      }
      3: {
        sig_d2h = SE1;
        //sig_d2h_jk = SE1;
      }
    }
  }

  enum DevState: bit<_> {
    WaitAttach,   // デバイス接続待ち
    WaitDebounce, // デバイスが安定するまで 100ms 以上待機
    DetectSpeed,
    BusReset,     // バスのリセット中（10ms～20ms）
    Enabling,     // デバイス有効化中
    Enabled,      // デバイス有効
    WaitDetachStable,
    DetectDetach,
  }
  import DevState::*;

  var dev_state : DevState;
  var ms_tim : bit<10>; // 1ms 単位で時間を計るタイマ（0～1023）

  always_ff (clk, rst_n) {
    if_reset {
      dev_speed = NoDevice;
      dev_state = WaitAttach;
      ms_tim = 0;
      dev_en = 0;
      force_h2d = 0;
    } else {
      case dev_state {
        WaitAttach: {
          dev_speed = NoDevice;
          ms_tim = 0;
          dev_en = 0;

          if dp_d2h | dm_d2h {
            dev_state = WaitDebounce;
          }
        }
        WaitDebounce:
          if ms_tick {
            if ms_tim == 99 {
              dev_state = DetectSpeed;
              ms_tim = 0;
            } else {
              ms_tim += 1;
            }
          }
        DetectSpeed:
          case sig_d2h {
            BusState::SE0: dev_state = WaitAttach;
            BusState::D0: {
              dev_state = BusReset;
              dev_speed = LS;
            }
            BusState::D1: {
              dev_state = BusReset;
              dev_speed = FS;
            }
            default: // Error
              dev_state = WaitAttach;
          }
        BusReset: {
          force_h2d = 1;
          if ms_tick {
            if ms_tim == 10 {
              dev_state = Enabling;
              ms_tim = 0;
            } else {
              ms_tim += 1;
            }
          }
        }
        Enabling: {
          dev_state = Enabled;
          force_h2d = 0;
        }
        Enabled: {
          dev_en = 1;
          if dir_h2d == 0 && sig_d2h == BusState::SE0 {
            dev_state = WaitDetachStable;
          }
          if ms_tick {
            if ms_tim == 1000 {
              // デバッグのための処理。
              // デバイスを抜き挿ししなくても信号を観測できるように、
              // 1 秒間隔でデバイス接続から再実行する。
              dev_state = WaitAttach;
              ms_tim = 0;
            } else {
              ms_tim += 1;
            }
          }
        }
        WaitDetachStable:
          if ms_tick {
            if ms_tim == 2 {
              dev_state = DetectDetach;
              ms_tim = 0;
            } else {
              ms_tim += 1;
            }
          }
        DetectDetach:
          if dir_h2d == 0 && sig_d2h == BusState::SE0 {
            dev_speed = NoDevice;
            dev_state = WaitAttach;
          } else {
            dev_state = Enabled;
          }
      }
    }
  }

  always_ff (clk, rst_n) {
    if_reset {
      dp_h2d = 0;
      dm_h2d = 0;
    } else if dev_state == BusReset {
      dp_h2d = 0;
      dm_h2d = 0;
    } else if dev_state == Enabling {
      // 最初にゴミデータが出ないよう、J 状態に相当する初期値を設定する
      // そのためにはデバイスのスピードが判明している必要がある
      dp_h2d = dev_speed == FS;
      dm_h2d = dev_speed == LS;
    } else if bit_tick {
      case sig_h2d {
        BusState::J: {
          dp_h2d = dev_speed == FS;
          dm_h2d = dev_speed == LS;
        }
        BusState::K: {
          dp_h2d = ~(dev_speed == FS);
          dm_h2d = ~(dev_speed == LS);
        }
        BusState::SE0: {
          dp_h2d = 0;
          dm_h2d = 0;
        }
        BusState::SE1: {
          dp_h2d = 1;
          dm_h2d = 1;
        }
        default: { // D0 or D1
          if sig_h2d == BusState::D0 { // NRZI
            dp_h2d = ~dp_h2d;
            dm_h2d = ~dm_h2d;
          }
        }
      }
    }
  }

}

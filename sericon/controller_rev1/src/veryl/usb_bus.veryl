import usb::*;
import usb::BusState::*;
import usb::DevSpeed::*;

module usb_bus #(
  param CLOCK_HZ: u32 = 48_000_000,
) (
  clk: input clock,
  rst_n: input reset_async_low,
  ms_tick: input bit, // 1ms 間隔の始まりを示す 1 サイクル幅のパルス
  dev_speed: output DevSpeed, // 検出したデバイス速度
  dev_en: output bit, // デバイスが接続されバスリセットが完了した状態
  dp_raw: inout 'usb_raw tri logic,
  dm_raw: inout 'usb_raw tri logic,
  dir_h2d: input bit, // 1 = output (host to device)
  sig_h2d: input BusState,
  valid_h2d: input bit, // sig_h2d が有効であることを示す
  sig_d2h: output BusState,
  valid_d2h: output bit, // sig_d2h が有効であることを示す
) {
  var dat_h2d : logic<2>; // [1]=D+ [0]=D-
  var dat_d2h : logic<2>;
  var force_h2d : bit;

  unsafe (cdc) {
    inst usb_sync: $std::synchronizer_basic #(
      WIDTH: 2,
      STAGES: 2,
    ) (
      i_clk: clk,
      i_rst: rst_n,
      i_d: {dp_raw, dm_raw},
      o_d: dat_d2h,
    );

    assign dp_raw = if (dir_h2d | force_h2d) ? dat_h2d[1] : 1'bz;
    assign dm_raw = if (dir_h2d | force_h2d) ? dat_h2d[0] : 1'bz;
  }


  var bit_tim_max : bit<$clog2(CLOCK_HZ / 1_500_000)>; // 1 ビットの期間
  always_ff (clk, rst_n) {
    if_reset {
      bit_tim_max = 0;
    } else if bit_tim_max == 0 {
      bit_tim_max = case dev_speed {
        LS: CLOCK_HZ / 1_500_000 - 1,
        FS: CLOCK_HZ / 12_000_000 - 1,
        default: 0,
      };
    }
  }

  enum RecvState {
    Send, // 送信中（受信待機）
    Init, // スタートビット待ち（初期 J 状態）
    Recv, // 受信中
    Error, // 受信エラー検出
  }

  var recv_state : RecvState;
  var recv_tim : bit<$clog2(CLOCK_HZ / 1_500_000)>;
  var dat_prev : logic<2>;
  var recv_bit1_cnt : bit<3>; // 連続する 1 の数（ビットスタッフィング用）

  always_ff (clk, rst_n) {
    if_reset {
      recv_state = RecvState::Send;
      recv_tim = '0;
      dat_prev = '0;
      recv_bit1_cnt = 0;
      valid_d2h = 0;
      sig_d2h = SE0;
    } else if dir_h2d {
      recv_state = RecvState::Send;
      recv_tim = '0;
      recv_bit1_cnt = 0;
      valid_d2h = 0;
    } else {
      case recv_state {
        RecvState::Send: {
          if dat_d2h == dev_speed { // J state
            recv_state = RecvState::Init;
            dat_prev = dat_d2h;
          }
        }
        RecvState::Init: {
          if dat_d2h == ~dev_speed { // K state
            recv_state = RecvState::Recv;
            sig_d2h = L0;
          }
        }
        RecvState::Recv: {
          if recv_tim == bit_tim_max / 2 - 1 {
            recv_tim += 1;

            let sig : BusState = switch {
              dat_d2h == 2'b00 : SE0,
              dat_d2h == 2'b11 : SE1,
              default : switch { // 2'b01 or 2'b10
                dat_d2h == ~dat_prev  : L0,
                dat_d2h == dat_prev   : L1,
                dat_d2h == dev_speed  : J, // L0/L1 以外からの J への遷移
                default               : K, // L0/L1 以外からの K への遷移
              }
            };
            sig_d2h = sig;

            if dat_prev == 2'b00 && sig == J {
              // EOP: SE0 -> J
              recv_state = RecvState::Init;
            }

            if sig == L0 {
              if recv_bit1_cnt >= 6 {
                // ビットスタッフィングなので無視する
              } else {
                valid_d2h = 1;
              }
              recv_bit1_cnt = 0;
            } else if sig == L1 {
              if recv_bit1_cnt >= 6 {
                recv_state = RecvState::Error;
              } else {
                recv_bit1_cnt += 1;
                valid_d2h = 1;
              }
            } else {
              valid_d2h = 1;
            }

            dat_prev = dat_d2h;
          } else {
            valid_d2h = 0;
            if recv_tim == bit_tim_max {
              recv_tim = '0;
            } else {
              recv_tim += 1;
            }
          }
        }
        RecvState::Error: {
        }
      }
    }
  }

  enum DevState: bit<_> {
    WaitAttach,   // デバイス接続待ち
    WaitDebounce, // デバイスが安定するまで 100ms 以上待機
    DetectSpeed,
    BusReset,     // バスのリセット中（10ms～20ms）
    Enabling,     // デバイス有効化中
    Enabled,      // デバイス有効
    WaitDetachStable,
    DetectDetach,
  }
  import DevState::*;

  var dev_state : DevState;
  var ms_tim : bit<10>; // 1ms 単位で時間を計るタイマ（0～1023）

  always_ff (clk, rst_n) {
    if_reset {
      dev_speed = NoDevice;
      dev_state = WaitAttach;
      ms_tim = 0;
      dev_en = 0;
      force_h2d = 0;
    } else {
      case dev_state {
        WaitAttach: {
          dev_speed = NoDevice;
          ms_tim = 0;
          dev_en = 0;

          if dat_d2h[1] | dat_d2h[0] {
            dev_state = WaitDebounce;
          }
        }
        WaitDebounce:
          if ms_tick {
            if ms_tim == 99 {
              dev_state = DetectSpeed;
              ms_tim = 0;
            } else {
              ms_tim += 1;
            }
          }
        DetectSpeed:
          case dat_d2h {
            2'b00: dev_state = WaitAttach;
            2'b01: {
              dev_state = BusReset;
              dev_speed = LS;
            }
            2'b10: {
              dev_state = BusReset;
              dev_speed = FS;
            }
            default: // Error
              dev_state = WaitAttach;
          }
        BusReset: {
          force_h2d = 1;
          if ms_tick {
            if ms_tim == 10 {
              dev_state = Enabling;
              ms_tim = 0;
            } else {
              ms_tim += 1;
            }
          }
        }
        Enabling: {
          dev_state = Enabled;
        }
        Enabled: {
          force_h2d = 0;
          dev_en = 1;
          if dir_h2d == 0 && dat_d2h == 2'b00 {
            dev_state = WaitDetachStable;
          }
        }
        WaitDetachStable:
          if ms_tick {
            if ms_tim == 2 {
              dev_state = DetectDetach;
              ms_tim = 0;
            } else {
              ms_tim += 1;
            }
          }
        DetectDetach:
          if dir_h2d == 0 && dat_d2h == 2'b00 {
            dev_speed = NoDevice;
            dev_state = WaitAttach;
          } else {
            dev_state = Enabled;
          }
      }
    }
  }

  always_ff (clk, rst_n) {
    if_reset {
      dat_h2d = 0;
    } else if dev_state == BusReset {
      dat_h2d = 0;
    } else if dev_state == Enabling {
      // 最初にゴミデータが出ないよう、J 状態に相当する初期値を設定する
      // そのためにはデバイスのスピードが判明している必要がある
      dat_h2d = dev_speed;
    } else if ~dir_h2d {
      dat_h2d = dev_speed;
    } else if valid_h2d {
      case sig_h2d {
        J: {
          dat_h2d = dev_speed;
        }
        K: {
          dat_h2d = ~dev_speed;
        }
        SE0: {
          dat_h2d = '0;
        }
        SE1: {
          dat_h2d = '1;
        }
        default: { // L0 or L1
          if sig_h2d == L0 { // NRZI
            dat_h2d = ~dat_h2d;
          }
        }
      }
    }
  }

}
